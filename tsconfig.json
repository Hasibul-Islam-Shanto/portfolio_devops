{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "astro.config.mjs", "vitest.config.ts"],
  "exclude": ["dist"],
  "compilerOptions": {
    "types": ["vitest/globals", "vitest/config"],
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
