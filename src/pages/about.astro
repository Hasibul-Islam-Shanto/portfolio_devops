---
import BaseLayout from "../layouts/base-layout.astro";
import Header from "../components/navbar/header.astro";
import aboutData from "../data/about.json";

const { intro, photo, story, quickFacts, education } = aboutData;
---

<BaseLayout
  title="About — Hasibul Islam Shanto | DevOps Engineer"
  description={intro.lede}
  ogImage={photo.src}
>
  <Header currentPath="/about" />
  <main class="section-surface min-h-screen pt-28 md:pt-24 pb-24">
    <div class="site-container py-12 md:py-16">
      <div class="grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:items-start">
        <div>
          <p class="section-eyebrow font-mono text-xs uppercase tracking-[0.25em] text-signal">
            01 / {intro.kicker}
          </p>
          <h1 class="mt-4 text-[clamp(32px,4vw,52px)] font-bold leading-[1.1] tracking-tight">
            {intro.headline}
          </h1>
          <p class="mt-4 text-lg leading-relaxed text-signal font-medium">
            {intro.lede}
          </p>

          <div class="mt-8 space-y-4 text-base leading-relaxed dim sm:text-lg">
            {story.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href="/#test"
              class="rounded-full bg-signal px-6 py-3 font-mono text-xs font-bold uppercase text-signal-foreground transition-transform hover:-translate-y-0.5 sm:text-sm"
            >
              View the work &rarr;
            </a>
            <a
              href="/#scale"
              class="rounded-full border hairline px-6 py-3 font-mono text-xs font-bold uppercase transition-colors hover:border-signal hover:text-signal sm:text-sm"
            >
              Get in touch
            </a>
          </div>
        </div>

        <div class="space-y-8">
          <!-- Portrait Card -->
          <div class="overflow-hidden rounded-3xl border hairline bg-surface/40 p-4">
            <div class="aspect-square w-full overflow-hidden rounded-2xl border hairline bg-surface/70">
              <img
                src={photo.src}
                alt={photo.alt}
                class="h-full w-full object-cover"
                loading="eager"
              />
            </div>
            <div class="mt-4 px-2 flex items-center justify-between font-mono text-xs dim">
              <span>Hasibul Islam Shanto</span>
              <span class="text-signal">Rangpur, Bangladesh</span>
            </div>
          </div>

          <!-- Quick Facts Grid -->
          <div class="rounded-3xl border hairline bg-surface/30 p-6">
            <h2 class="font-mono text-xs uppercase tracking-widest text-signal font-bold">
              Quick Facts
            </h2>
            <dl class="mt-4 grid grid-cols-2 gap-4 font-mono text-xs">
              {quickFacts.map((fact) => (
                <div class="rounded-xl border hairline p-3.5 bg-surface/50">
                  <dt class="dim text-[11px] uppercase tracking-wider">{fact.label}</dt>
                  <dd class="mt-1 font-semibold text-[var(--text)]">{fact.value}</dd>
                  <p class="mt-0.5 text-[10px] dim truncate">{fact.detail}</p>
                </div>
              ))}
            </dl>
          </div>

          <!-- Education Card -->
          <div class="rounded-3xl border hairline bg-surface/30 p-6">
            <h2 class="font-mono text-xs uppercase tracking-widest text-signal font-bold">
              Formal Education
            </h2>
            <div class="mt-4">
              <h3 class="text-base font-bold tracking-tight">
                {education.degree}
              </h3>
              <p class="mt-1 font-mono text-xs dim">
                {education.university} · {education.period}
              </p>
              <span class="mt-3 inline-block rounded-full bg-signal/15 px-3 py-1 font-mono text-xs font-semibold text-signal">
                CGPA: {education.cgpa}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

