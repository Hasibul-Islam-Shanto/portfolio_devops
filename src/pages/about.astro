---
import BaseLayout from "../layouts/base-layout.astro";
import Header from "../components/navbar/header.astro";
import CardParticleBackground from "../components/shared/card-particle-background.astro";
import PageHero from "../components/shared/page-hero.astro";
import RevealOnScroll from "../components/shared/reveal-on-scroll.astro";
import aboutData from "../data/about.json";
import ExperienceCard from "../components/experience/experience-card.astro";
import { EXPERIENCE_ROLES } from "../components/experience/experience-data";
import { ABOUT_CATEGORIES, ABOUT_TOOLS } from "../data/about-tools";

const { intro, photo, quickFacts, education } = aboutData;

const categoryCounts = ABOUT_CATEGORIES.reduce(
  (acc, cat) => {
    acc[cat] =
      cat === "All" ? ABOUT_TOOLS.length : ABOUT_TOOLS.filter((t) => t.category === cat).length;
    return acc;
  },
  {} as Record<string, number>,
);

const BIO_CHAPTERS = [
  {
    id: "background",
    label: "Background",
    paragraphs: [
      "I started in product UI, then followed the work into APIs, databases, and the pipelines that keep them shipping. Today I build CI/CD, containers, and cloud infrastructure so production stays boring.",
    ],
  },
  {
    id: "education",
    label: "Education",
    paragraphs: [
      "During my undergraduate studies in Computer Science & Engineering at Shahjalal University of Science and Technology (SUST), I built a solid foundation in core computer science—data structures, algorithms, operating systems, and computer networks.",
    ],
  },
  {
    id: "early-career",
    label: "Early Career",
    paragraphs: [
      "I translated that foundation into real-world shipping early on as a Junior Web Developer at InnovexIT, building responsive appointment and workforce management platforms with React, Next.js, and TypeScript.",
    ],
  },
  {
    id: "shift-to-devops",
    label: "The Shift to DevOps",
    paragraphs: [
      "From January 2024 to June 2026, I worked as a Front-End Engineer at Universal Machine Inc. I engineered the front-end architecture for an enterprise carbon credit platform handling end-to-end workflows from methodology creation to carbon inventory management. I also contributed to a Web3 Minipay wallet platform used by 200,000+ people, implementing smart contract interactions via Ethers.js and wallet integrations with RainbowKit. To keep systems performant and unified, I designed backend REST APIs using Node.js and Express, managed relational database schemas with PostgreSQL and Prisma ORM, and set up automated GitHub Actions CI/CD pipelines to lint, test, and validate every merge.",
      "Working across both application code and production delivery showed me how much developer speed and reliability depend on what happens between commit and deploy. That experience drove my focus into DevOps, containerization, and platform engineering. In projects like OrderFirst, I designed an event-driven microservices architecture backed by selective git-diff Jenkins builds, RabbitMQ messaging, zero-downtime rolling container updates, and hardened network isolation.",
    ],
  },
  {
    id: "recognition",
    label: "Recognition",
    paragraphs: [
      "In competitive research and hackathons, I led initiatives that secured 1st Runner-Up at the Smart Village Idea Competition, a Top-10 ranking at the Bangladesh Blockchain Olympiad, and a published paper at IEEE ICCIT on decentralized stakeholder collaboration.",
      "Today, I am based in Dhaka, Bangladesh, and actively open to work for DevOps, Cloud, and Platform Engineering roles—combining a developer's empathy for user experience with a systems engineer's obsession for resilient, automated production platforms.",
    ],
  },
];
---

<BaseLayout
  title="About — Hasibul Islam Shanto | DevOps Engineer"
  description={intro.lede}
  ogImage={photo.src}
>
  <Header currentPath="/about" />

  <main class="section-surface min-h-screen pt-28 md:pt-24 pb-28 md:pb-36">
    <div class="site-container py-12 md:py-16">
      {/* Top Hero & Narrative Section with Sticky Facts Sidebar */}
      <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
        {/* Left Column: Page Hero + Restructured Labeled Bio Sub-Sections */}
        <div class="min-w-0">
          <PageHero
            eyebrow="Background // Narrative & Foundations"
            title={intro.headline}
            description={intro.lede}
          />

          <div class="mt-12 space-y-10">
            {BIO_CHAPTERS.map((chapter, i) => (
              <RevealOnScroll
                as="section"
                aria-labelledby={`bio-${chapter.id}`}
                index={i}
                stagger={0.08}
                maxDelay={0.3}
                class="border-t hairline pt-7 space-y-3"
              >
                <h3
                  id={`bio-${chapter.id}`}
                  class="font-mono text-xs uppercase tracking-[0.2em] text-signal font-semibold select-none"
                >
                  {chapter.label}
                </h3>
                <div class="space-y-4 text-base leading-relaxed dim sm:text-[17px]">
                  {chapter.paragraphs.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              </RevealOnScroll>
            ))}
          </div>

          <RevealOnScroll delay={0.25} class="mt-12 flex flex-wrap gap-4">
            <a
              href="/projects"
              class="rounded-full bg-signal px-6 py-3 font-mono text-xs font-bold uppercase text-signal-foreground transition-transform hover:-translate-y-0.5 sm:text-sm"
            >
              View all projects &rarr;
            </a>
            <a
              href="/#contact"
              class="rounded-full border hairline px-6 py-3 font-mono text-xs font-bold uppercase transition-colors hover:border-signal hover:text-signal sm:text-sm"
            >
              Get in touch
            </a>
          </RevealOnScroll>
        </div>

        {/* Right Column: Sticky Sidebar on Desktop */}
        <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
          {/* Identity Card: Avatar Image + Name/Location/Role */}
          <RevealOnScroll variant="scale" delay={0.15}>
            <div class="group relative overflow-hidden rounded-3xl bg-surface/30 p-4 sm:p-5 transition-colors">
              <CardParticleBackground />
              <div class="relative z-10 flex flex-col">
                <div class="aspect-square w-full overflow-hidden rounded-2xl border hairline bg-surface/70 shadow-inner">
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    class="h-full w-full object-cover"
                    loading="eager"
                  />
                </div>
                <div class="mt-4 px-1 text-center">
                  <h3 class="font-display text-lg font-bold tracking-tight text-[var(--text)]">
                    Hasibul Islam Shanto
                  </h3>
                  <p class="mt-1 font-mono text-xs text-signal">Dhaka, Bangladesh</p>
                  <p class="mt-0.5 font-mono text-xs text-[var(--text)]/70">
                    DevOps &amp; Platform Engineer
                  </p>
                </div>
              </div>
            </div>
          </RevealOnScroll>

          {/* Quick Facts Card */}
          <RevealOnScroll delay={0.25}>
            <div class="group relative overflow-hidden rounded-3xl border hairline bg-surface/30 p-6 transition-colors hover:border-signal/40">
              <CardParticleBackground />
              <div class="relative z-10">
                <h2 class="font-mono text-xs uppercase tracking-widest text-signal font-bold">
                  Quick Facts
                </h2>
                <dl class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs">
                  {quickFacts.map((fact) => (
                    <div class="rounded-xl border hairline p-3.5 bg-surface/50">
                      <dt class="dim text-[11px] uppercase tracking-wider">{fact.label}</dt>
                      <dd class="mt-1 font-semibold text-[var(--text)]">{fact.value}</dd>
                      <p class="mt-0.5 text-[10px] dim leading-snug">{fact.detail}</p>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </RevealOnScroll>

          {/* Formal Education Card */}
          <RevealOnScroll delay={0.35}>
            <div class="group relative overflow-hidden rounded-3xl border hairline bg-surface/30 p-6 transition-colors hover:border-signal/40">
              <CardParticleBackground />
              <div class="relative z-10">
                <h2 class="font-mono text-xs uppercase tracking-widest text-signal font-bold">
                  Formal Education
                </h2>
                <div class="mt-4">
                  <h3 class="text-base font-bold tracking-tight">{education.degree}</h3>
                  <p class="mt-1 font-mono text-xs dim">
                    {education.university} · {education.period}
                  </p>
                  <span class="mt-3 inline-block rounded-full bg-signal/15 px-3 py-1 font-mono text-xs font-semibold text-signal">
                    CGPA: {education.cgpa}
                  </span>
                </div>
              </div>
            </div>
          </RevealOnScroll>
        </aside>
      </div>

      {/* Experience Timeline Section (Reusing Collapsible Git-Log Component) */}
      <section class="mt-32 md:mt-40 border-t hairline pt-16 md:pt-20">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <RevealOnScroll>
            <p class="section-eyebrow font-mono text-xs uppercase tracking-[0.25em] text-signal font-semibold">
              Career Journey // Production Experience
            </p>
            <h2 class="mt-3 text-[clamp(26px,3vw,40px)] font-bold tracking-tight text-[var(--text)]">
              Where I've built &amp; shipped.
            </h2>
            <p class="mt-3 max-w-2xl text-base dim">
              A chronological timeline of engineering roles building enterprise web applications,
              Web3 platforms, and automated pipelines.
            </p>
          </RevealOnScroll>
          <span class="font-mono text-xs uppercase tracking-wider text-[var(--text)]/60 pb-1">
            {EXPERIENCE_ROLES.length} roles · since 2022
          </span>
        </div>

        <ol data-timeline class="relative mt-14 space-y-6">
          <span
            class="absolute bottom-4 left-3 md:left-4 top-4 w-px bg-current opacity-20"
            aria-hidden="true"
          ></span>
          <span
            data-timeline-progress
            class="absolute bottom-4 left-3 md:left-4 top-4 w-px origin-top bg-signal"
            style="transform: scaleY(0)"
            aria-hidden="true"
          ></span>

          {EXPERIENCE_ROLES.map((item, i) => (
            <ExperienceCard item={item} index={i} />
          ))}
        </ol>
      </section>

      {/* Technical Competencies / Filterable Toolchain Catalog */}
      <section class="mt-32 md:mt-40 border-t hairline pt-16 md:pt-20">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <RevealOnScroll>
            <p class="section-eyebrow font-mono text-xs uppercase tracking-[0.25em] text-signal font-semibold">
              Capabilities // Technical Stack
            </p>
            <h2 class="mt-3 text-[clamp(26px,3vw,40px)] font-bold tracking-tight text-[var(--text)]">
              Skills &amp; tooling breakdown.
            </h2>
            <p class="mt-3 max-w-2xl text-base dim">
              Tools, languages, and platforms applied in production systems and curriculum
              tutorials.
            </p>
          </RevealOnScroll>

          <div
            class="flex items-center gap-2 font-mono text-xs tracking-wider text-[var(--text)]/75 self-start md:self-end pb-1"
            aria-live="polite"
          >
            <span class="inline-block h-2 w-2 rounded-full bg-signal" aria-hidden="true"></span>
            <span data-tool-counter>
              <span data-count-num>{ABOUT_TOOLS.length}</span> <span data-count-label>tools</span>
            </span>
          </div>
        </div>

        <div data-toolchain class="mt-12">
          <div
            role="tablist"
            aria-label="Tool categories"
            class="flex flex-wrap gap-2 overflow-x-auto pb-2"
          >
            {ABOUT_CATEGORIES.map((cat, i) => {
              const count = categoryCounts[cat] ?? 0;
              const isInitial = i === 0;
              return (
                <button
                  type="button"
                  role="tab"
                  data-filter-tab={cat}
                  aria-selected={isInitial ? "true" : "false"}
                  tabindex={isInitial ? 0 : -1}
                  class:list={[
                    "tool-tab group relative inline-flex cursor-pointer items-center justify-center rounded-full border px-4 py-2 font-mono text-xs uppercase tracking-wider select-none",
                    isInitial ? "is-active" : "",
                  ]}
                >
                  <span>{cat}</span>
                  <sup
                    class="ml-1 font-mono text-[9px] font-bold opacity-80"
                    aria-label={`${count} tools`}
                  >
                    {count}
                  </sup>
                </button>
              );
            })}
          </div>

          <div
            data-tool-grid
            class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 md:grid-cols-4 lg:grid-cols-6"
          >
            {ABOUT_TOOLS.map((tool, i) => {
              const staggerDelay = ((i % 6) * 0.05 + Math.floor(i / 6) * 0.06).toFixed(2);
              return (
                <div data-reveal style={`--reveal-delay: ${staggerDelay}s`}>
                  <div
                    data-tool-card
                    data-tool-name={tool.name}
                    data-tool-cat={tool.category}
                    tabindex="0"
                    data-cursor-interactive="true"
                    class="tool-catalog-card is-active-tool flex aspect-square flex-col justify-between rounded-2xl p-4 sm:p-5 transition-all focus-visible:outline-none"
                  >
                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white shadow-xs border border-black/5 p-2 transition-transform duration-200">
                      <svg
                        viewBox={tool.viewBox ?? "0 0 24 24"}
                        class="h-6 w-6 transition-transform duration-200"
                        aria-hidden="true"
                        set:html={tool.svgInner}
                      />
                    </div>

                    <div class="mt-auto pt-3">
                      <h3 class="font-display text-sm font-bold tracking-tight text-[var(--text)] leading-snug">
                        {tool.name}
                      </h3>
                      <p class="mt-1 font-mono text-[10px] lowercase tracking-wider text-[var(--text)]/60">
                        {tool.tag}
                      </p>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { initExperience } from "../components/experience/experience";
  import { initToolchain } from "../components/toolstack/toolchain";

  initExperience();
  initToolchain();
</script>
