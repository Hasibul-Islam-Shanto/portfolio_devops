---
import BaseLayout from "../../layouts/base-layout.astro";
import Header from "../../components/navbar/header.astro";
import projectsData from "../../data/projects.json";

export function getStaticPaths() {
  return projectsData.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const otherProject = projectsData.find((p) => p.slug !== project.slug);
---

<BaseLayout
  title={`${project.name} — Case Study | Hasibul Islam Shanto`}
  description={project.summary}
  ogDescription={project.outcome}
>
  <Header currentPath="/case-studies" />

  <main class="section-surface min-h-screen pt-28 md:pt-24 pb-24">
    <div class="site-container py-10 md:py-14">
      <div>
        <a
          href="/#test"
          class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold uppercase tracking-wider text-signal hover:underline"
        >
          <span>&larr;</span>
          <span>Back to Projects</span>
        </a>
      </div>

      <div class="mt-8 border-b hairline pb-8">
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-signal font-semibold">
          {project.category}
        </p>
        <h1 class="mt-3 text-[clamp(28px,3.8vw,48px)] font-bold leading-[1.15] tracking-tight text-[var(--text)]">
          {project.name}
        </h1>
        <p class="mt-4 max-w-3xl text-base sm:text-lg leading-relaxed dim">{project.summary}</p>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          {project.githubUrl && (
            <a
              href={project.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full border hairline bg-surface px-5 py-2.5 font-mono text-xs font-semibold uppercase tracking-wider text-[var(--text)] transition-colors hover:border-signal hover:text-signal"
            >
              <svg
                class="h-4 w-4 shrink-0"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
              </svg>
              <span>GitHub Repository</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          )}
          {project.blogHref && (
            <a
              href={project.blogHref}
              class="inline-flex items-center gap-2 rounded-full bg-signal px-5 py-2.5 font-mono text-xs font-bold uppercase tracking-wider text-signal-foreground transition-transform hover:-translate-y-0.5"
            >
              <span>{project.blogLabel || "Read Pipeline Guide"}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          )}
        </div>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-2">
        <div class="rounded-3xl border hairline bg-surface/40 p-7 sm:p-9 space-y-4">
          <p class="font-mono text-xs uppercase tracking-wider text-signal font-bold">
            01 / Challenge &amp; Problem
          </p>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text)]">
            Release bottlenecks &amp; downtime risks
          </h2>
          <p class="text-sm sm:text-base leading-relaxed dim">{project.problem}</p>
        </div>

        <div class="rounded-3xl border hairline bg-surface/40 p-7 sm:p-9 space-y-4">
          <p class="font-mono text-xs uppercase tracking-wider text-signal font-bold">
            02 / Solution &amp; Architecture
          </p>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text)]">
            Automated quality-gated delivery
          </h2>
          <p class="text-sm sm:text-base leading-relaxed dim">{project.solution}</p>
        </div>
      </div>

      <div class="mt-8 grid gap-8 lg:grid-cols-2">
        <div class="rounded-3xl border hairline bg-surface/40 p-7 sm:p-9">
          <p class="font-mono text-xs uppercase tracking-wider text-signal font-bold mb-4">
            03 / DevOps &amp; Infrastructure Highlights
          </p>
          <ul class="space-y-3.5">
            {project.devopsHighlights.map((highlight) => (
              <li class="flex items-start gap-3 text-sm sm:text-[15px] leading-relaxed">
                <span
                  class="mt-1.5 block h-2 w-2 shrink-0 rounded-full bg-signal"
                  aria-hidden="true"
                />
                <span class="text-[var(--text)]/90">{highlight}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-3xl border hairline bg-surface/40 p-7 sm:p-9">
          <p class="font-mono text-xs uppercase tracking-wider text-signal font-bold mb-4">
            04 / Application &amp; Resiliency Features
          </p>
          <ul class="space-y-3.5">
            {project.applicationFeatures.map((feat) => (
              <li class="flex items-start gap-3 text-sm sm:text-[15px] leading-relaxed">
                <span
                  class="mt-1.5 block h-2 w-2 shrink-0 rounded-full bg-signal/60"
                  aria-hidden="true"
                />
                <span class="text-[var(--text)]/90">{feat}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mt-8 rounded-3xl border hairline bg-surface/40 p-7 sm:p-9">
        <p class="font-mono text-xs uppercase tracking-wider text-signal font-bold mb-4">
          05 / Complete Technology Stack
        </p>
        <div class="flex flex-wrap gap-2">
          {project.stack.map((item) => (
            <span class="rounded-xl border hairline bg-surface/70 px-3.5 py-1.5 font-mono text-xs uppercase tracking-wider text-[var(--text)]/90">
              {item.label}
            </span>
          ))}
        </div>
      </div>

      <div class="mt-8 rounded-3xl border border-signal/30 bg-signal/5 p-7 sm:p-9">
        <p class="font-mono text-xs uppercase tracking-widest text-signal font-bold">
          06 / Verified Production Outcome
        </p>
        <p class="mt-2 text-base sm:text-lg font-medium leading-relaxed text-[var(--text)]">
          {project.outcome}
        </p>
      </div>

      {otherProject && (
        <div class="mt-16 border-t hairline pt-8 flex items-center justify-between">
          <a
            href="/#test"
            class="font-mono text-xs uppercase tracking-wider text-signal hover:underline"
          >
            &larr; Back to all projects
          </a>
          <a
            href={`/case-studies/${otherProject.slug}`}
            class="font-mono text-xs font-bold uppercase tracking-wider text-signal hover:underline"
          >
            Next Project: {otherProject.name.split("—")[0]?.trim() ?? "Next"} &rarr;
          </a>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
