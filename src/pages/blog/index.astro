---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/base-layout.astro";
import Header from "../../components/navbar/header.astro";
import blogsMetadata from "../../data/blogs-metadata.json";

let posts: any[] = [];
try {
  posts = (await getCollection("blogs")).filter((p) => !p.data.draft);
} catch {
  posts = [];
}

if (!posts || posts.length === 0) {
  posts = blogsMetadata.map((b) => ({
    id: b.slug,
    data: {
      title: b.title,
      description: b.description,
      pubDate: new Date(b.pubDate),
      readTime: b.readTime,
      tags: b.tags,
      featuredImage: b.featuredImage,
    },
  }));
}

posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Blog — Hasibul Islam Shanto | DevOps Engineer"
  description="Practical engineering write-ups on Jenkins, CI/CD pipelines, Kubernetes, Docker, and cloud-native systems."
  ogDescription="Production guides and platform architecture notes from Hasibul Islam Shanto."
>
  <Header currentPath="/blog" />
  <main class="section-surface min-h-screen pt-28 md:pt-24 pb-20">
    <div class="site-container py-12 md:py-16">
      <p class="section-eyebrow font-mono text-xs uppercase tracking-[0.25em] text-signal">
        Articles &amp; Field Notes
      </p>
      <h1 class="mt-4 max-w-3xl text-[clamp(32px,4vw,52px)] font-bold leading-[1.1] tracking-tight">
        Production notes on <span class="text-signal">CI/CD &amp; Kubernetes</span>.
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed dim sm:text-lg">
        End-to-end implementation guides, cluster architectures, and delivery pipelines tested in real environments.
      </p>

      <div class="mt-12 grid gap-8 md:grid-cols-2">
        {
          posts.map((post) => (
            <article class="group flex flex-col justify-between rounded-3xl border hairline bg-surface/40 p-7 transition-all duration-300 hover:border-signal">
              <div>
                {post.data.featuredImage && (
                  <a href={`/blog/${post.id}`} class="mb-5 block aspect-[16/9] overflow-hidden rounded-2xl border hairline bg-surface/60">
                    <img
                      src={post.data.featuredImage}
                      alt={post.data.title}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </a>
                )}
                <div class="flex items-center gap-3 font-mono text-xs dim">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </time>
                  {post.data.readTime && (
                    <>
                      <span>·</span>
                      <span class="text-signal">{post.data.readTime}</span>
                    </>
                  )}
                </div>
                <h2 class="mt-3 text-xl font-bold leading-snug tracking-tight sm:text-2xl">
                  <a
                    href={`/blog/${post.id}`}
                    class="transition-colors hover:text-signal"
                  >
                    {post.data.title}
                  </a>
                </h2>
                <p class="mt-3 text-sm leading-relaxed dim">
                  {post.data.description}
                </p>
              </div>

              <div class="mt-6 pt-5 border-t hairline flex flex-wrap items-center justify-between gap-3">
                <ul class="flex flex-wrap gap-1.5" aria-label="Tags">
                  {post.data.tags.slice(0, 3).map((tag: string) => (
                    <li class="rounded-md border hairline px-2 py-0.5 font-mono text-[10px] uppercase text-[var(--text)]/70">
                      #{tag}
                    </li>
                  ))}
                </ul>
                <a
                  href={`/blog/${post.id}`}
                  class="font-mono text-xs font-bold uppercase tracking-wider text-signal hover:underline"
                >
                  Read article &rarr;
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>
