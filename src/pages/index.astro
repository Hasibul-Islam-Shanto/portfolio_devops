---
import BaseLayout from "../layouts/base-layout.astro";
import Header from "../components/navbar/header.astro";
import PipelineRail from "../components/pipeline-rail/pipeline-rail.astro";
import Hero from "../components/hero/hero.astro";
import TechMarquee from "../components/logos/tech-marquee.astro";
import Work from "../components/projects/work.astro";
import Experience from "../components/experience/experience.astro";
import Toolchain from "../components/toolstack/toolchain.astro";
import Certifications from "../components/certifications/certifications.astro";
import HowIWork from "../components/how-it-works/how-i-work.astro";
import Principles from "../components/principles/principles.astro";
import Contact from "../components/contact/contact.astro";

const sectionClass = (mode: string = "dark") =>
  `section-surface rail-safe mode-${mode} relative scroll-mt-24 md:scroll-mt-16 outline-none focus:outline-none focus-visible:outline-none`;
---

<BaseLayout
  title="Shanto — DevOps & Platform Engineer"
  description="Pipelines, Kubernetes platforms and observability that let teams ship safely. Portfolio of a DevOps / Platform Engineer."
  ogDescription="Build → Test → Deploy → Monitor → Scale. Six production systems, told as a pipeline."
  twitterCard="summary_large_image"
>
  <Header currentPath="/" />
  <PipelineRail />
  <main class="overflow-x-clip">
    <section id="hero" class={sectionClass("dark")}>
      <span id="build" class="section-stage-anchor" aria-hidden="true"></span>
      <Hero />
    </section>
    <TechMarquee />
    <section id="projects" class={sectionClass("dark")}>
      <span id="test" class="section-stage-anchor" aria-hidden="true"></span>
      <Work />
    </section>
    <section id="experience" class={sectionClass("dark")}>
      <Experience />
    </section>
    <section id="toolchain" class={sectionClass("dark")}>
      <span id="deploy" class="section-stage-anchor" aria-hidden="true"></span>
      <Toolchain />
    </section>
    <section id="certifications" class={sectionClass("dark")}>
      <Certifications />
    </section>
    <section id="process" class={sectionClass("dark")}>
      <HowIWork />
    </section>
    <section id="principles" class={sectionClass("dark")}>
      <span id="monitor" class="section-stage-anchor" aria-hidden="true"></span>
      <Principles />
    </section>
    <section id="contact" class={sectionClass("dark")}>
      <span id="scale" class="section-stage-anchor" aria-hidden="true"></span>
      <Contact />
    </section>
  </main>
</BaseLayout>

<script>
  import { initSectionNav } from "../scripts/section-nav";
  initSectionNav();
</script>
