---
import BaseLayout from "../layouts/base-layout.astro";
import Header from "../components/navbar/header.astro";
import PipelineRail from "../components/pipeline-rail/pipeline-rail.astro";
import Hero from "../components/hero/hero.astro";
import TechMarquee from "../components/logos/tech-marquee.astro";
import Work from "../components/projects/work.astro";
import Experience from "../components/experience/experience.astro";
import Toolchain from "../components/toolstack/toolchain.astro";
import Certifications from "../components/certifications/certifications.astro";
import HowIWork from "../components/how-it-works/how-i-work.astro";
import Principles from "../components/principles/principles.astro";
import Contact from "../components/contact/contact.astro";

const sectionClass = (mode: string = "dark") =>
  `section-surface rail-safe mode-${mode} relative scroll-mt-24 md:scroll-mt-16`;
---

<BaseLayout
  title="Shanto — DevOps & Platform Engineer"
  description="Pipelines, Kubernetes platforms and observability that let teams ship safely. Portfolio of a DevOps / Platform Engineer."
  ogDescription="Build → Test → Deploy → Monitor → Scale. Six production systems, told as a pipeline."
  twitterCard="summary_large_image"
>
  <Header currentPath="/" />
  <PipelineRail />
  <main class="overflow-x-clip">
    <section id="build" class={sectionClass("dark")}><Hero /></section>
    <TechMarquee />
    <section id="test" class={sectionClass("dark")}><Work /></section>
    <!-- PLACEHOLDER: Replace all company names, roles, dates, locations, bullet points, and tech tags below with real work history before publishing -->
    <section class={sectionClass("dark")}><Experience /></section>
    <section id="deploy" class={sectionClass("dark")}><Toolchain /></section>
    <!-- PLACEHOLDER: Replace certification names, years, and icons with real credentials before publishing -->
    <section class={sectionClass("dark")}><Certifications /></section>
    <section class={sectionClass("dark")}><HowIWork /></section>
    <section id="monitor" class={sectionClass("dark")}><Principles /></section>
    <!-- PLACEHOLDER: Writings section goes here once added -->
    <section id="scale" class={sectionClass("dark")}><Contact /></section>
  </main>
</BaseLayout>

