---
import BaseLayout from "../layouts/base-layout.astro";
import Header from "../components/portfolio/header.astro";
import PipelineRail from "../components/portfolio/pipeline-rail.astro";
import Hero from "../components/portfolio/hero.astro";
import Work from "../components/portfolio/work.astro";
import HowIWork from "../components/portfolio/how-i-work.astro";
import Toolchain from "../components/portfolio/toolchain.astro";
import Certifications from "../components/portfolio/certifications.astro";
import Experience from "../components/portfolio/experience.astro";
import About from "../components/portfolio/about.astro";
import Testimonials from "../components/portfolio/testimonials.astro";
import Contact from "../components/portfolio/contact.astro";

const sectionClass = (mode: string) =>
  `section-surface rail-safe mode-${mode} relative scroll-mt-24 md:scroll-mt-16`;
---

<BaseLayout
  title="Shanto — DevOps & Platform Engineer"
  description="Pipelines, Kubernetes platforms and observability that let teams ship safely. Portfolio of a DevOps / Platform Engineer."
  ogDescription="Build → Test → Deploy → Monitor → Scale. Six production systems, told as a pipeline."
  twitterCard="summary_large_image"
>
  <Header currentPath="/" />
  <PipelineRail />
  <main class="overflow-x-clip">
    <section id="build" class={sectionClass("dark")}><Hero /></section>
    <section id="test" class={sectionClass("dark")}><Work /></section>
    <section class={sectionClass("light")}><HowIWork /></section>
    <section id="deploy" class={sectionClass("dark")}><Toolchain /></section>
    <Fragment set:html="<!-- PLACEHOLDER: Replace certification names, years, and icons with real credentials before publishing -->" />
    <section class={sectionClass("dark")}><Certifications /></section>
    <Fragment set:html="<!-- PLACEHOLDER: Replace all company names, roles, dates, locations, bullet points, and tech tags below with real work history before publishing -->" />
    <section class={sectionClass("light")}><Experience /></section>
    <section id="monitor" class={sectionClass("dark")}><About /></section>
    <Fragment set:html="<!-- PLACEHOLDER: Replace with 2-3 real testimonials from managers, teammates, or clients before publishing -->" />
    <section class={sectionClass("light")}><Testimonials /></section>
    <section id="scale" class={sectionClass("signal")}><Contact /></section>
  </main>
</BaseLayout>

