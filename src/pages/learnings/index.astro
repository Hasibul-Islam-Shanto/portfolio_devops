---
import BaseLayout from "../../layouts/base-layout.astro";
import Header from "../../components/navbar/header.astro";
import learningsData from "../../data/learnings-metadata.json";

const { topics } = learningsData;
const totalLessons = topics.reduce((sum, t) => sum + t.lessonCount, 0);
---

<BaseLayout
  title="DevOps Learnings & Curriculum — Hasibul Islam Shanto"
  description="A structured curriculum of 55 hands-on DevOps tutorials covering Linux, Networking, Docker, Kubernetes, Terraform, Ansible, and GitHub Actions."
  ogDescription="55 hands-on lessons across 8 core DevOps engineering topics."
>
  <Header currentPath="/learnings" />
  <main class="section-surface min-h-screen pt-28 md:pt-24 pb-24">
    <div class="site-container py-12 md:py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="section-eyebrow font-mono text-xs uppercase tracking-[0.25em] text-signal">
            Curriculum &amp; Tutorials
          </p>
          <h1 class="mt-4 max-w-3xl text-[clamp(32px,4vw,52px)] font-bold leading-[1.1] tracking-tight">
            DevOps <span class="text-signal">Learnings</span> &amp; Notes.
          </h1>
          <p class="mt-4 max-w-2xl text-base leading-relaxed dim sm:text-lg">
            A comprehensive, hands-on syllabus covering fundamental infrastructure concepts, container runtimes, orchestration, and CI/CD pipelines.
          </p>
        </div>
        <span class="rounded-full border hairline bg-surface/60 px-4 py-2 font-mono text-xs uppercase tracking-wider text-signal">
          {totalLessons} lessons · {topics.length} topics
        </span>
      </div>

      <div class="mt-14 grid gap-8 lg:grid-cols-2">
        {
          topics.map((topic) => (
            <div class="rounded-3xl border hairline bg-surface/30 p-7 transition-all duration-300 hover:border-signal">
              <div class="flex items-center justify-between gap-4">
                <h2 class="text-2xl font-bold tracking-tight">
                  {topic.title}
                </h2>
                <span class="font-mono text-xs font-semibold uppercase tracking-wider text-signal">
                  {topic.lessonCount > 0 ? `${topic.lessonCount} lessons` : "Blog Guide"}
                </span>
              </div>
              <p class="mt-2 text-sm leading-relaxed dim">
                {topic.description}
              </p>

              {topic.lessons.length > 0 ? (
                <ol class="mt-6 space-y-2 border-t hairline pt-5 font-mono text-xs">
                  {topic.lessons.map((lesson) => (
                    <li>
                      <a
                        href={`/learnings/${topic.slug}/${lesson.slug}`}
                        class="group flex items-center justify-between rounded-xl p-2.5 transition-colors hover:bg-surface/80"
                      >
                        <span class="flex items-center gap-3 truncate">
                          <span class="dim group-hover:text-signal">
                            {String(lesson.order).padStart(2, "0")}.
                          </span>
                          <span class="font-medium text-[var(--text)] group-hover:text-signal truncate">
                            {lesson.title}
                          </span>
                        </span>
                        <span class="dim group-hover:text-signal ml-2 text-xs">
                          &rarr;
                        </span>
                      </a>
                    </li>
                  ))}
                </ol>
              ) : (
                <div class="mt-6 border-t hairline pt-5">
                  <a
                    href="/blog/how-to-setup-jenkins"
                    class="inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-wider text-signal hover:underline"
                  >
                    Read the complete Jenkins CI/CD Guide &rarr;
                  </a>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>

