---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/base-layout.astro";
import Header from "../../components/navbar/header.astro";
import learningsData from "../../data/learnings-metadata.json";

export async function getStaticPaths() {
  const lessons = await getCollection("learnings");
  return lessons.map((lesson) => ({
    params: { slug: lesson.id },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);

const topicSlug = lesson.id.split("/")[0];
const currentTopic = learningsData.topics.find((t) => t.slug === topicSlug);

const topicLessons = currentTopic?.lessons || [];
const currentIndex = topicLessons.findIndex(
  (l) => `${topicSlug}/${l.slug}` === lesson.id,
);
const prevLesson = currentIndex > 0 ? topicLessons[currentIndex - 1] : null;
const nextLesson =
  currentIndex >= 0 && currentIndex < topicLessons.length - 1
    ? topicLessons[currentIndex + 1]
    : null;
---

<BaseLayout
  title={`${lesson.data.title} — ${currentTopic?.title || "DevOps"} Learnings | Shanto`}
  description={lesson.data.description}
  ogType="article"
>
  <Header currentPath="/learnings" />
  <main class="section-surface min-h-screen pt-28 md:pt-24 pb-24">
    <div class="site-container py-8 md:py-12">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-8 font-mono text-xs uppercase tracking-wider">
        <a href="/learnings" class="dim hover:text-signal">Learnings</a>
        <span class="mx-2 dim">/</span>
        <span class="text-signal">{currentTopic?.title || topicSlug}</span>
      </nav>

      <div class="grid gap-12 lg:grid-cols-[1fr_280px]">
        <!-- Main Lesson Content -->
        <article class="min-w-0">
          <header class="border-b hairline pb-6">
            <span class="font-mono text-xs uppercase tracking-widest text-signal">
              Lesson {String(lesson.data.order).padStart(2, "0")} of {topicLessons.length}
            </span>
            <h1 class="mt-3 text-[clamp(28px,3.5vw,44px)] font-bold leading-[1.15] tracking-tight">
              {lesson.data.title}
            </h1>
            <p class="mt-3 text-base leading-relaxed dim sm:text-lg">
              {lesson.data.description}
            </p>
          </header>

          <div class="markdown-body mt-8">
            <Content />
          </div>

          <!-- Bottom Prev / Next Nav -->
          <nav
            aria-label="Lesson navigation"
            class="mt-14 border-t hairline pt-8 flex flex-wrap items-center justify-between gap-4 font-mono text-xs"
          >
            {prevLesson ? (
              <a
                href={`/learnings/${topicSlug}/${prevLesson.slug}`}
                class="flex items-center gap-2 rounded-xl border hairline p-3 transition-colors hover:border-signal"
              >
                <span>&larr;</span>
                <span class="truncate max-w-[200px]">Prev: {prevLesson.title}</span>
              </a>
            ) : <span />}

            {nextLesson ? (
              <a
                href={`/learnings/${topicSlug}/${nextLesson.slug}`}
                class="flex items-center gap-2 rounded-xl border hairline bg-signal/10 p-3 text-signal transition-colors hover:bg-signal hover:text-signal-foreground ml-auto"
              >
                <span class="truncate max-w-[200px]">Next: {nextLesson.title}</span>
                <span>&rarr;</span>
              </a>
            ) : (
              <a
                href="/learnings"
                class="rounded-xl border hairline p-3 text-signal ml-auto"
              >
                Back to Curriculum &rarr;
              </a>
            )}
          </nav>
        </article>

        <!-- Sidebar Topic Index (Desktop) -->
        <aside class="hidden lg:block">
          <div class="sticky top-28 rounded-2xl border hairline bg-surface/30 p-5">
            <div class="font-mono text-xs uppercase tracking-wider text-signal font-semibold">
              {currentTopic?.title} Topics
            </div>
            <p class="mt-1 font-mono text-[11px] dim">
              {topicLessons.length} lessons
            </p>
            <ol class="mt-4 space-y-1.5 border-t hairline pt-3 font-mono text-xs">
              {topicLessons.map((item) => {
                const isActive = `${topicSlug}/${item.slug}` === lesson.id;
                return (
                  <li>
                    <a
                      href={`/learnings/${topicSlug}/${item.slug}`}
                      class:list={[
                        "flex items-center gap-2 rounded-lg p-2 transition-colors",
                        isActive
                          ? "bg-signal text-signal-foreground font-semibold"
                          : "dim hover:text-signal hover:bg-surface/60",
                      ]}
                    >
                      <span class="text-[10px] opacity-80">{String(item.order).padStart(2, "0")}.</span>
                      <span class="truncate">{item.title}</span>
                    </a>
                  </li>
                );
              })}
            </ol>
            <div class="mt-5 border-t hairline pt-3">
              <a
                href="/learnings"
                class="block text-center font-mono text-xs uppercase tracking-wider text-signal hover:underline"
              >
                All Topics &rarr;
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>
</BaseLayout>

