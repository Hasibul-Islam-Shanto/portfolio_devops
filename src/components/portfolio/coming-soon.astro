---
import Header from "./header.astro";

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  currentPath: string;
}

const { eyebrow, title, body, currentPath } = Astro.props;
---

<Header currentPath={currentPath} />
<main class="section-surface mode-light flex min-h-screen items-center pt-28 md:pt-20">
  <div class="site-container py-24">
    <p class="font-mono text-xs uppercase tracking-[0.25em] dim">{eyebrow}</p>
    <h1
      class="mt-4 max-w-3xl text-[clamp(32px,4.8vw,58px)] font-bold leading-[1.1] tracking-tight"
    >
      {title}
    </h1>
    <p class="mt-6 max-w-xl text-lg dim">{body}</p>
    <a
      href="/#test"
      data-cursor-cta="true"
      data-cursor-label="WORK"
      class="mt-8 inline-block rounded-full bg-signal px-6 py-3 font-mono text-sm font-bold uppercase text-signal-foreground transition-transform hover:-translate-y-0.5"
    >
      See the projects →
    </a>
  </div>
</main>

