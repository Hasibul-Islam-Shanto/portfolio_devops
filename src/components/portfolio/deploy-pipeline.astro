---
import Icon from "./icon.astro";
import type { IconName } from "./icons";

interface DiagramNode {
  id: string;
  label: string;
  x: number;
  y: number;
  labelAlign: "below-center" | "below-right" | "below-left";
  icon: IconName;
}

const NODE_SIZE = 60;

/**
 * 11 nodes on an orthogonal grid (each 60x60):
 * Row 0: GIT -> GITHUB -> CI; Row 1: CI down to TEST, left to BUILD;
 * Row 2: BUILD down to DOCKER -> REGISTRY -> DEPLOY; Row 3: DEPLOY down to K8S;
 * Row 4: K8S down to APP, APP left to MONITOR.
 */
const NODES: DiagramNode[] = [
  { id: "git", label: "GIT", x: 20, y: 70, labelAlign: "below-center", icon: "SiGit" },
  { id: "github", label: "GITHUB", x: 200, y: 70, labelAlign: "below-center", icon: "SiGithub" },
  { id: "ci", label: "CI", x: 380, y: 70, labelAlign: "below-right", icon: "SiGithubactions" },
  { id: "test", label: "TEST", x: 380, y: 210, labelAlign: "below-center", icon: "FlaskConical" },
  { id: "build", label: "BUILD", x: 200, y: 210, labelAlign: "below-right", icon: "Hammer" },
  { id: "docker", label: "DOCKER", x: 200, y: 386, labelAlign: "below-center", icon: "SiDocker" },
  { id: "registry", label: "REGISTRY", x: 380, y: 386, labelAlign: "below-center", icon: "Package" },
  { id: "deploy", label: "DEPLOY", x: 560, y: 386, labelAlign: "below-right", icon: "Cloud" },
  { id: "k8s", label: "K8S", x: 560, y: 558, labelAlign: "below-right", icon: "SiKubernetes" },
  { id: "app", label: "APP", x: 560, y: 730, labelAlign: "below-center", icon: "Server" },
  { id: "monitor", label: "MONITOR", x: 380, y: 730, labelAlign: "below-center", icon: "Activity" },
];

const ZONES = [
  { label: "SOURCE", x: 20, y: 24, anchor: "start" },
  { label: "CI PIPELINE", x: 380, y: 24, anchor: "start" },
  { label: "ARTIFACTS · INFRA", x: 380, y: 340, anchor: "start" },
  { label: "ORCHESTRATION", x: 602, y: 512, anchor: "start" },
  { label: "RUNTIME", x: 500, y: 684, anchor: "middle" },
] as const;

/** Straight horizontal/vertical segment endpoints that end flush with adjacent node edges. */
function connector(from: DiagramNode, to: DiagramNode) {
  const fromCx = from.x + NODE_SIZE / 2;
  const fromCy = from.y + NODE_SIZE / 2;
  const toCx = to.x + NODE_SIZE / 2;
  const toCy = to.y + NODE_SIZE / 2;
  if (from.y === to.y) {
    return to.x > from.x
      ? { x1: from.x + NODE_SIZE, y1: fromCy, x2: to.x, y2: toCy }
      : { x1: from.x, y1: fromCy, x2: to.x + NODE_SIZE, y2: toCy };
  }
  return to.y > from.y
    ? { x1: fromCx, y1: from.y + NODE_SIZE, x2: toCx, y2: to.y }
    : { x1: fromCx, y1: from.y, x2: toCx, y2: to.y + NODE_SIZE };
}
---

<div data-deploy-pipeline data-node-count={NODES.length} class="w-full max-w-full min-w-0 text-[#EFE6D8]">
  <div class="w-full max-w-full min-w-0">
    <svg
      viewBox="0 0 740 830"
      class="block h-auto w-full max-w-full select-none"
      role="img"
      aria-label="11-node deployment pipeline architecture diagram"
    >
      {
        ZONES.map((zone) => (
          <text
            data-zone-label={zone.label}
            x={zone.x}
            y={zone.y}
            text-anchor={zone.anchor}
            fill="#E8503A"
            class="font-mono text-[11px] font-semibold uppercase"
            style="letter-spacing: 0.08em"
          >
            {zone.label}
          </text>
        ))
      }

      {
        NODES.slice(0, -1).map((node, idx) => {
          const next = NODES[idx + 1]!;
          const c = connector(node, next);
          return (
            <line
              data-pipeline-connector={`${node.id}-${next.id}`}
              data-connector-done={idx === 0 ? "false" : "false"}
              x1={c.x1}
              y1={c.y1}
              x2={c.x2}
              y2={c.y2}
              stroke-width="2"
              class="dp-connector"
            />
          );
        })
      }

      <path
        data-feedback-loop="true"
        data-feedback-active="false"
        d="M 380 760 C 250 760, 250 426, 380 426"
        fill="none"
        stroke-width="2"
        stroke-dasharray="6 6"
        class="dp-feedback"></path>

      {
        NODES.map((node, idx) => {
          const cx = node.x + NODE_SIZE / 2;
          const cy = node.y + NODE_SIZE / 2;
          const labelX =
            node.labelAlign === "below-right" ? cx + 12 : node.labelAlign === "below-left" ? cx - 12 : cx;
          const anchor =
            node.labelAlign === "below-right" ? "start" : node.labelAlign === "below-left" ? "end" : "middle";
          return (
            <g data-pipeline-node={node.label} data-node-state={idx === 0 ? "done" : "pending"} class="dp-node">
              <rect x={node.x} y={node.y} width={NODE_SIZE} height={NODE_SIZE} rx="14" fill="transparent" stroke-width="2" />
              <g transform={`translate(${cx - 12}, ${cy - 12})`} class="dp-icon">
                <Icon name={node.icon} size={24} />
              </g>
              {node.id === "monitor" && (
                <rect
                  data-monitor-dot="true"
                  data-dot-active="false"
                  x={node.x + NODE_SIZE - 12}
                  y={node.y + 6}
                  width="6"
                  height="6"
                  class="dp-dot"
                />
              )}
              <text
                data-node-label={node.label}
                x={labelX}
                y={node.y + NODE_SIZE + 20}
                text-anchor={anchor}
                class="dp-label font-mono text-[11px] font-medium uppercase"
                style="letter-spacing: 0.06em"
              >
                {node.label}
              </text>
            </g>
          );
        })
      }
    </svg>
  </div>

  <p aria-live="polite" class="mt-6 font-mono text-xs uppercase tracking-[0.08em] text-[#EFE6D8]">
    PIPELINE · RELEASE #<span data-release-num>2463</span> —{" "}
    <span data-pipeline-status class="font-bold text-[#E8503A]">RUNNING</span>
  </p>
</div>

<script>
  import { initDeployPipeline } from "../../scripts/deploy-pipeline";
  initDeployPipeline();
</script>

