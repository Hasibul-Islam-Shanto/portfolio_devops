---
import { getBSTTime } from "../../scripts/contact";

const initialBST = getBSTTime();
---

<div
  class="mx-auto w-full max-w-[1280px] px-5 pt-12 pb-8 text-[#C9CDD6] sm:px-6 md:px-8 md:pt-16 md:pb-8 lg:px-16 lg:pt-[76px] lg:pb-12"
>
  <!-- Eyebrow row at top: small coral dot (7px, circular) + mono-font label "07 · CONTACT" in muted grey, letter-spacing 0.12em -->
  <div class="flex items-center gap-2.5">
    <span class="h-[7px] w-[7px] shrink-0 rounded-full bg-[#FF6B47]" aria-hidden="true"></span>
    <span class="font-mono text-xs uppercase tracking-[0.12em] text-[#686E82]">
      07 · CONTACT
    </span>
  </div>

  <!-- Terminal Window Card: styled with distinct border, background & depth like Hero section -->
  <div
    class="mt-6 overflow-hidden rounded-2xl border border-[#3A4152] bg-[#0B0F19] shadow-[0_24px_60px_-15px_rgba(0,0,0,0.7),0_0_0_1px_rgba(255,255,255,0.04)]"
  >
    <!-- Title bar: flex row, 12px gap, padding 12px 18px, bottom border #3A4152 -->
    <div
      class="flex items-center gap-3 border-b border-[#3A4152] bg-[#10151F]/90 px-[18px] py-3.5"
    >
      <!-- Three traffic-light dots (11px circles): #FF5F57, #FEBC2E, #28C840 -->
      <div class="flex items-center gap-2" aria-hidden="true">
        <span class="h-[11px] w-[11px] rounded-full bg-[#FF5F57]"></span>
        <span class="h-[11px] w-[11px] rounded-full bg-[#FEBC2E]"></span>
        <span class="h-[11px] w-[11px] rounded-full bg-[#28C840]"></span>
      </div>
      <!-- Mono text "shanto@portfolio:~" in #5B6072, margin-left 8px -->
      <span class="ml-2 font-mono text-xs text-[#686E82]">shanto@portfolio:~</span>
    </div>

    <!-- Body: compact padding & spacing -->
    <div class="flex flex-col gap-5 p-5 sm:p-7 md:p-8 lg:p-9">
      <!-- 1. Mono-font line: coral "$" + white "whoami", then muted line "> Platform engineer · open to remote roles" -->
      <div>
        <div class="flex items-center font-mono text-sm">
          <span class="mr-2 font-bold text-[#FF6B47]" aria-hidden="true">$</span>
          <span class="text-[#F5EFE3]">whoami</span>
        </div>
        <p class="mt-1 font-mono text-xs text-[#8B90A0] sm:text-sm">
          &gt; Platform engineer · open to remote roles
        </p>
      </div>

      <!-- 2. Mono coral line "$ cat contact.txt" followed by large heading -->
      <div class="flex flex-col gap-2">
        <div class="font-mono text-xs font-semibold text-[#FF6B47] sm:text-sm">
          $ cat contact.txt
        </div>
        <h2
          class="max-w-5xl font-sans text-3xl font-bold leading-[1.15] tracking-tight text-[#F5EFE3] sm:text-4xl md:text-[44px]"
        >
          Let's ship something <span class="text-[#FF6B47]">that doesn't page anyone.</span>
        </h2>
      </div>

      <!-- 3. Email row: flex, 16px gap, mono font 22px, off-white email text + outlined "copy" button + blinking coral cursor block (█) -->
      <div
        class="flex flex-wrap items-center justify-between gap-4 border-y border-[#1D2230] py-3.5 sm:py-4"
      >
        <div class="flex flex-wrap items-center gap-3 sm:gap-4">
          <a
            href="mailto:hello@shanto.dev"
            class="rounded font-mono text-lg tracking-tight text-[#F5EFE3] transition-colors hover:text-[#FF6B47] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF6B47] sm:text-xl md:text-[22px]"
          >
            hello@shanto.dev
          </a>
          <button
            type="button"
            data-copy-email="hello@shanto.dev"
            aria-label="Copy email address"
            class="rounded-[6px] border border-[#2C3240] px-3 py-[5px] font-mono text-xs text-[#8B90A0] transition-colors duration-150 hover:border-[#FF6B47] hover:text-[#F5EFE3] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF6B47]"
          >
            copy
          </button>
        </div>
        <span class="footer-terminal-cursor font-mono text-xl select-none" aria-hidden="true"
          >█</span
        >
      </div>

      <!-- 4. Action row: Two CTA buttons on left + Social icon buttons on the right side -->
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-3 sm:gap-4">
          <!-- Primary: coral background, dark navy text (#0D111A), Inter 600, 15px, padding 14px 26px, fully rounded (999px), label "Start a conversation →" -->
          <a
            href="mailto:hello@shanto.dev"
            data-cursor-cta="true"
            data-cursor-label="TALK ↗"
            class="inline-flex items-center justify-center rounded-full bg-[#FF6B47] px-6 py-3 font-sans text-sm font-semibold text-[#0D111A] transition-all duration-200 hover:brightness-110 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF6B47] sm:px-[26px] sm:py-[14px] sm:text-[15px]"
          >
            Start a conversation →
          </a>
          <!-- Secondary: transparent bg, 1px border #2C3240, off-white text, same sizing, label "Download résumé ↓" -->
          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full border border-[#2C3240] bg-transparent px-6 py-3 font-sans text-sm font-semibold text-[#F5EFE3] transition-all duration-200 hover:border-[#FF6B47] hover:text-[#FF6B47] hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF6B47] sm:px-[26px] sm:py-[14px] sm:text-[15px]"
          >
            Download résumé ↓
          </a>
        </div>

        <!-- Row of 3 icon buttons placed to the right of CTAs: GitHub, LinkedIn, X/Twitter -->
        <div class="flex items-center gap-2.5 sm:gap-3">
          <a
            href="https://github.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="flex h-[38px] w-[38px] items-center justify-center rounded-[8px] border border-[#2C3240] text-[#C9CDD6] transition-colors duration-150 hover:border-[#FF6B47] hover:text-[#FF6B47] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF6B47]"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              ></path>
            </svg>
          </a>
          <a
            href="https://linkedin.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="flex h-[38px] w-[38px] items-center justify-center rounded-[8px] border border-[#2C3240] text-[#C9CDD6] transition-colors duration-150 hover:border-[#FF6B47] hover:text-[#FF6B47] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF6B47]"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              ></path>
            </svg>
          </a>
          <a
            href="https://x.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X (Twitter)"
            class="flex h-[38px] w-[38px] items-center justify-center rounded-[8px] border border-[#2C3240] text-[#C9CDD6] transition-colors duration-150 hover:border-[#FF6B47] hover:text-[#FF6B47] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF6B47]"
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom Bar (outside the terminal card) -->
  <div
    class="mt-8 flex flex-wrap items-center justify-between gap-4 font-mono text-xs text-[#686E82] md:mt-10"
  >
    <div>© 2026 Shanto · Dhaka, Bangladesh</div>
    <div class="flex items-center gap-1.5">
      <span>BST</span>
      <time data-bst-time data-ist-time class="text-[#8B90A0]">{initialBST}</time>
      <span>· Bangladesh</span>
    </div>
  </div>
</div>

<script>
  import { initContact } from "../../scripts/contact";
  initContact();
</script>
