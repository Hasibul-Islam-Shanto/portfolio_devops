---
import Icon from "./icon.astro";

interface Props {
  /** Current pathname, used for the server-rendered active nav state (header.ts keeps hash state live). */
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const NAV = [
  { label: "Home", href: "/", path: "/", hash: "" },
  { label: "Projects", href: "/#test", path: "/", hash: "#test" },
  { label: "Case Studies", href: "/case-studies", path: "/case-studies", hash: "" },
  { label: "Blog", href: "/blog", path: "/blog", hash: "" },
  { label: "Contact", href: "/#scale", path: "/", hash: "#scale" },
] as const;

const SOCIAL = [
  { label: "LinkedIn", href: "https://www.linkedin.com/", icon: "Linkedin" },
  { label: "GitHub", href: "https://github.com/", icon: "Github" },
] as const;

const isActive = (n: (typeof NAV)[number]) => n.path === currentPath && n.hash === "";
---

<header
  data-site-header
  class="pointer-events-none fixed inset-x-0 top-4 z-50 w-full"
>
  <div class="site-container">
    <div class="flex items-center justify-between gap-4">
    <div
      class="float-header header-pill section-surface mode-dark pointer-events-auto flex items-center gap-4 rounded-full border px-2.5"
    >
      <a
        href="/"
        aria-label="shanto home"
        class="group flex shrink-0 items-center gap-2.5 pl-1.5 pr-1"
      >
        <span
          data-header-logo="true"
          aria-hidden="true"
          class="relative flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border-2 border-signal bg-[#10151F]/90 text-signal shadow-[0_0_16px_-4px_rgba(232,80,58,0.45)] transition-all duration-300 group-hover:bg-signal/15 group-hover:shadow-[0_0_22px_-2px_rgba(232,80,58,0.75)]"
        >
          <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5 overflow-visible" aria-hidden="true">
            <path
              d="M6.5 8L11.5 12.5L6.5 17"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform duration-300 ease-out group-hover:translate-x-[1.5px]"
            ></path>
            <line
              x1="13"
              y1="17"
              x2="18"
              y2="17"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              class="terminal-cursor-blink"></line>
          </svg>
        </span>
        <span
          class="font-display text-lg font-bold tracking-tight text-[#EFE6D8] transition-colors duration-200 group-hover:text-signal"
        >
          shanto
        </span>
      </a>

      <nav aria-label="Main" class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {
            NAV.map((n) => (
              <li>
                <a
                  href={n.href}
                  class="nav-link"
                  data-nav-path={n.path}
                  data-nav-hash={n.hash}
                  aria-current={isActive(n) ? "page" : undefined}
                >
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="float-header header-pill section-surface mode-dark pointer-events-auto flex items-center gap-2 rounded-full border pl-3 pr-2"
    >
      <ul class="flex items-center gap-1" aria-label="Social profiles">
        {
          SOCIAL.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noreferrer"
                aria-label={s.label}
                class="flex h-9 w-9 items-center justify-center rounded-full text-[#EFE6D8]/75 transition-colors hover:bg-[#EFE6D8]/[0.07] hover:text-signal"
              >
                <Icon name={s.icon} class="h-4 w-4" />
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href="/#scale"
        data-cursor-cta="true"
        data-cursor-label="HIRE"
        class="shrink-0 rounded-full bg-signal px-5 py-2 font-mono text-xs font-bold text-signal-foreground transition-transform hover:-translate-y-0.5"
      >
        Hire me
      </a>
    </div>
  </div>

  <nav
    aria-label="Main mobile"
    class="float-header header-pill section-surface mode-dark pointer-events-auto mt-2 overflow-hidden rounded-full border px-2 lg:hidden"
  >
    <ul class="flex items-center gap-1 overflow-x-auto">
      {
        NAV.map((n) => (
          <li class="shrink-0">
            <a
              href={n.href}
              class="nav-link"
              data-nav-path={n.path}
              data-nav-hash={n.hash}
              aria-current={isActive(n) ? "page" : undefined}
            >
              {n.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  </div>
</header>

<script>
  import { initHeader } from "../../scripts/header";
  initHeader();
</script>

