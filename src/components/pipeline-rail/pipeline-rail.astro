---
const SECTIONS = [
  { id: "hero", label: "Hero" },
  { id: "projects", label: "Projects" },
  { id: "experience", label: "Experience" },
  { id: "toolchain", label: "Toolchain" },
  { id: "certifications", label: "Certifications" },
  { id: "process", label: "Process" },
  { id: "principles", label: "Principles" },
  { id: "contact", label: "Contact" },
];
---

<div class="rail-float pointer-events-none fixed bottom-8 right-3 top-28 z-40 hidden md:block lg:right-6">
  <nav
    data-pipeline-rail
    aria-label="Section navigation rail"
    class="pipeline-rail h-full"
  >
    <ol class="relative flex h-full flex-col justify-between">
      <span class="absolute bottom-2 right-[5.5px] top-2 w-px bg-current opacity-40" aria-hidden="true"></span>
      <span
        data-rail-progress
        class="absolute bottom-2 right-[5.5px] top-2 w-px origin-top bg-signal"
        style="transform: scaleY(0)"
        aria-hidden="true"></span>
      {
        SECTIONS.map((s) => (
          <li class="relative z-10 h-4">
            <a
              href={`#${s.id}`}
              data-rail-link={s.id}
              tabindex="-1"
              class="flex h-4 items-center justify-end gap-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-signal"
            >
              <span
                data-rail-label
                class="rail-label hidden font-mono text-[10px] uppercase tracking-widest lg:inline"
              >
                {s.label}
              </span>
              <span class="sr-only lg:hidden">{s.label}</span>
              <span
                data-rail-dot
                class="rail-dot block h-3 w-3 shrink-0 rounded-full border-2 border-current bg-transparent"
              />
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</div>

<script>
  import { initPipelineRail } from "./pipeline-rail";
  initPipelineRail();
</script>

