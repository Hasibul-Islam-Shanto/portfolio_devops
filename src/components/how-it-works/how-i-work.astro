</div>

<style>
  /* Base card animation states: start invisible and empty until reached in sequence */
  .flow-card {
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    border-color: var(--terminal-border);
    background-color: var(--terminal-bg);
    transition:
      opacity 0.35s ease-out,
      transform 0.35s ease-out,
      border-color 0.3s ease-out,
      box-shadow 0.3s ease-out,
      background-color 0.3s ease-out,
      color 0.3s ease-out;
  }

  .flow-card[data-revealed="true"] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .flow-card[data-state="active"] {
    border-color: var(--signal) !important;
    box-shadow: 0 0 25px -2px color-mix(in oklab, var(--signal) 45%, transparent);
  }

  .flow-card[data-state="settled"] {
    border-color: var(--terminal-border);
    box-shadow: var(--terminal-shadow);
  }

  .flow-resolution-card {
    border-color: color-mix(in oklab, var(--signal) 40%, transparent);
    background-color: color-mix(in oklab, var(--signal) 6%, var(--terminal-bg));
  }

  .flow-resolution-card[data-state="active"] {
    border-color: var(--signal) !important;
    box-shadow: 0 0 30px -2px color-mix(in oklab, var(--signal) 50%, transparent);
  }

  .flow-resolution-card[data-state="settled"] {
    border-color: color-mix(in oklab, var(--signal) 40%, transparent);
    box-shadow: var(--terminal-shadow);
  }

  /* Body (title + description / stats) animation */
  .flow-body {
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.3s ease-out,
      transform 0.3s ease-out;
  }

  .flow-body[data-visible="true"] {
    opacity: 1;
    transform: translateY(0);
  }

  /* Result line animation */
  .flow-result {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s ease-out,
      transform 0.3s ease-out;
  }

  .flow-result[data-visible="true"] {
    opacity: 1;
    transform: translateY(0);
  }

  /* Connector styles */
  .flow-connector {
    opacity: 0.25;
    transition: opacity 250ms ease-out;
  }

  .flow-connector[data-drawn="true"] {
    opacity: 1;
  }

  .flow-connector [data-connector-line] {
    stroke-dasharray: 28;
    stroke-dashoffset: 28;
    transition: stroke-dashoffset 350ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .flow-connector[data-drawn="true"] [data-connector-line] {
    stroke-dashoffset: 0;
  }

  .flow-connector [data-connector-arrow] {
    opacity: 0;
    transition: opacity 150ms ease-out 200ms;
  }

  .flow-connector[data-drawn="true"] [data-connector-arrow] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-card,
    .flow-body,
    .flow-result,
    .flow-connector,
    .flow-connector [data-connector-line],
    .flow-connector [data-connector-arrow] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      pointer-events: auto !important;
    }
    .flow-connector [data-connector-line] {
      stroke-dashoffset: 0 !important;
    }
    .flow-connector [data-connector-arrow] {
      opacity: 1 !important;
    }
    .pulse-ring {
      display: none !important;
    }
  }
</style>

<script>
  import { initHowIWork } from "./how-i-work";
  initHowIWork();
</script>
