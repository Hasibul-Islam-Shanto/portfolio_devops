        data-step-cmd={step3.cmd}
        class="flow-card relative z-10 w-full overflow-hidden rounded-2xl border border-[var(--terminal-border)] bg-[var(--terminal-bg)] text-[var(--terminal-fg)] shadow-[var(--terminal-shadow)] transition-all duration-300 ease-out min-[860px]:[grid-column:5] min-[860px]:[grid-row:1]"
      >
        <div class="flex items-center border-b border-[var(--terminal-header-border)] bg-[var(--terminal-header-bg)] px-4 py-2.5">
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="h-2 w-2 rounded-full bg-[#FF5F56]/85" />
            <span class="h-2 w-2 rounded-full bg-[#FFBD2E]/85" />
            <span class="h-2 w-2 rounded-full bg-[#27C93F]/85" />
          </div>
        </div>
        <div class="p-4 sm:p-5">
          <div class="font-mono text-xs font-semibold text-[#E8503A] text-signal truncate flex items-center min-h-[1.25rem]"><span data-flow-cmd-text>{step3.cmd}</span><span data-flow-cursor class="ml-0.5 inline-block text-[#E8503A] text-signal font-bold" aria-hidden="true" style="display: none;">▍</span></div>
          <div data-flow-body class="flow-body">
            <h3 class="font-display text-base font-bold tracking-tight text-[var(--terminal-fg)] mt-2.5 sm:text-lg">
              {step3.title}
            </h3>
            <p class="font-mono text-[11px] leading-relaxed text-[var(--terminal-dim)] mt-1.5 sm:text-xs">
              {step3.desc}
            </p>
          </div>
          <div
            data-flow-result
            class="flow-result mt-3.5 flex items-center gap-2 border-t border-[var(--terminal-header-border)] pt-3 font-mono text-[11px] font-medium text-[var(--terminal-success)] sm:text-xs"
          >
            <span class="font-bold">✓</span>
            <span class="truncate">{step3.res}</span>
          </div>
        </div>
      </li>

      {/* Connector 2: Step 3 -> Step 4 (Vertical Down, Row 2, Col 5) */}
      <li
        data-flow-connector="2"
        aria-hidden="true"
        class="flow-connector hidden min-[860px]:flex h-full w-full items-center justify-center min-[860px]:[grid-column:5] min-[860px]:[grid-row:2]"
      >
        <svg viewBox="0 0 24 34" class="h-[34px] w-6 overflow-visible" aria-hidden="true">
          <path
            data-connector-line
            d="M 12 0 L 12 24"
            stroke="#E8503A"
            stroke-width="2"
            stroke-linecap="round"
            fill="none"
          />
          <polygon data-connector-arrow points="7,23 12,33 17,23" fill="#E8503A" />
        </svg>
      </li>

      {/* 4. Step 4: Review (Row 3, Col 5) */}
      <li
        data-flow-card
        data-step-index={3}
        data-step-cmd={step4.cmd}
        class="flow-card relative z-10 w-full overflow-hidden rounded-2xl border border-[var(--terminal-border)] bg-[var(--terminal-bg)] text-[var(--terminal-fg)] shadow-[var(--terminal-shadow)] transition-all duration-300 ease-out min-[860px]:[grid-column:5] min-[860px]:[grid-row:3]"
      >
        <div class="flex items-center border-b border-[var(--terminal-header-border)] bg-[var(--terminal-header-bg)] px-4 py-2.5">
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="h-2 w-2 rounded-full bg-[#FF5F56]/85" />
            <span class="h-2 w-2 rounded-full bg-[#FFBD2E]/85" />
            <span class="h-2 w-2 rounded-full bg-[#27C93F]/85" />
          </div>
        </div>
        <div class="p-4 sm:p-5">
          <div class="font-mono text-xs font-semibold text-[#E8503A] text-signal truncate flex items-center min-h-[1.25rem]"><span data-flow-cmd-text>{step4.cmd}</span><span data-flow-cursor class="ml-0.5 inline-block text-[#E8503A] text-signal font-bold" aria-hidden="true" style="display: none;">▍</span></div>
          <div data-flow-body class="flow-body">
            <h3 class="font-display text-base font-bold tracking-tight text-[var(--terminal-fg)] mt-2.5 sm:text-lg">
              {step4.title}
            </h3>
            <p class="font-mono text-[11px] leading-relaxed text-[var(--terminal-dim)] mt-1.5 sm:text-xs">
              {step4.desc}
            </p>
          </div>
          <div
            data-flow-result
            class="flow-result mt-3.5 flex items-center gap-2 border-t border-[var(--terminal-header-border)] pt-3 font-mono text-[11px] font-medium text-[var(--terminal-success)] sm:text-xs"
          >
            <span class="font-bold">✓</span>
            <span class="truncate">{step4.res}</span>
          </div>
        </div>
      </li>

      {/* Connector 3: Step 4 -> Step 5 (Horizontal Left, Row 3, Col 4) */}
      <li
        data-flow-connector="3"
        aria-hidden="true"
        class="flow-connector hidden min-[860px]:flex h-full w-full items-center justify-center min-[860px]:[grid-column:4] min-[860px]:[grid-row:3]"
      >
        <svg viewBox="0 0 34 24" class="h-6 w-[34px] overflow-visible" aria-hidden="true">
          <path
            data-connector-line
            d="M 34 12 L 10 12"
            stroke="#E8503A"
            stroke-width="2"
            stroke-linecap="round"
            fill="none"
          />
          <polygon data-connector-arrow points="11,7 1,12 11,17" fill="#E8503A" />
        </svg>
      </li>

      {/* 5. Step 5: Measure (Row 3, Col 3) */}
      <li
        data-flow-card
        data-step-index={4}
        data-step-cmd={step5.cmd}
        class="flow-card relative z-10 w-full overflow-hidden rounded-2xl border border-[var(--terminal-border)] bg-[var(--terminal-bg)] text-[var(--terminal-fg)] shadow-[var(--terminal-shadow)] transition-all duration-300 ease-out min-[860px]:[grid-column:3] min-[860px]:[grid-row:3]"
      >
        <div class="flex items-center border-b border-[var(--terminal-header-border)] bg-[var(--terminal-header-bg)] px-4 py-2.5">
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="h-2 w-2 rounded-full bg-[#FF5F56]/85" />
            <span class="h-2 w-2 rounded-full bg-[#FFBD2E]/85" />
            <span class="h-2 w-2 rounded-full bg-[#27C93F]/85" />
          </div>
        </div>
        <div class="p-4 sm:p-5">
          <div class="font-mono text-xs font-semibold text-[#E8503A] text-signal truncate flex items-center min-h-[1.25rem]"><span data-flow-cmd-text>{step5.cmd}</span><span data-flow-cursor class="ml-0.5 inline-block text-[#E8503A] text-signal font-bold" aria-hidden="true" style="display: none;">▍</span></div>
          <div data-flow-body class="flow-body">
            <h3 class="font-display text-base font-bold tracking-tight text-[var(--terminal-fg)] mt-2.5 sm:text-lg">
              {step5.title}
            </h3>
            <p class="font-mono text-[11px] leading-relaxed text-[var(--terminal-dim)] mt-1.5 sm:text-xs">
              {step5.desc}
            </p>
          </div>
          <div
            data-flow-result
            class="flow-result mt-3.5 flex items-center gap-2 border-t border-[var(--terminal-header-border)] pt-3 font-mono text-[11px] font-medium text-[var(--terminal-success)] sm:text-xs"
          >
            <span class="font-bold">✓</span>
            <span class="truncate">{step5.res}</span>
          </div>
        </div>
      </li>

      {/* Connector 4: Step 5 -> Resolution (Horizontal Left, Row 3, Col 2) */}
      <li
        data-flow-connector="4"
        aria-hidden="true"
        class="flow-connector hidden min-[860px]:flex h-full w-full items-center justify-center min-[860px]:[grid-column:2] min-[860px]:[grid-row:3]"
      >
        <svg viewBox="0 0 34 24" class="h-6 w-[34px] overflow-visible" aria-hidden="true">
          <path
            data-connector-line
            d="M 34 12 L 10 12"
            stroke="#E8503A"
            stroke-width="2"
            stroke-linecap="round"
            fill="none"
          />
          <polygon data-connector-arrow points="11,7 1,12 11,17" fill="#E8503A" />
        </svg>
      </li>

      {/* 6. Sixth Element: Resolution Card (Row 3, Col 1) */}
      <li
        data-flow-card
        data-flow-resolution
        data-step-index={5}
        class="flow-card flow-resolution-card relative z-10 w-full overflow-hidden rounded-2xl border border-signal/40 bg-signal/[0.06] text-[var(--terminal-fg)] shadow-[var(--terminal-shadow)] transition-all duration-300 ease-out min-[860px]:[grid-column:1] min-[860px]:[grid-row:3]"
      >
        <div class="flex items-center justify-between border-b border-[var(--terminal-header-border)] bg-[var(--terminal-header-bg)] px-4 py-2.5">
          <div class="flex items-center gap-2">
            <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
              <span class="pulse-ring absolute inline-flex h-full w-full rounded-full bg-signal opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-signal"></span>
            </span>
            <span class="font-mono text-[11px] font-bold tracking-wider text-signal uppercase">
              INCIDENT RESOLVED
