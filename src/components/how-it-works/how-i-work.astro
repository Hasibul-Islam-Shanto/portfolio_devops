              <div class="font-mono text-sm font-bold text-signal sm:text-base">&lt; 85ms</div>
              <div class="mt-0.5 font-mono text-[10px] leading-tight text-[var(--terminal-dim)]">p99 latency</div>
            </div>
            <div class="rounded-xl border border-[var(--terminal-header-border)] bg-[var(--terminal-bg)]/60 p-2 sm:p-2.5">
              <div class="font-mono text-sm font-bold text-signal sm:text-base">99.95%</div>
              <div class="mt-0.5 font-mono text-[10px] leading-tight text-[var(--terminal-dim)]">SLO held</div>
            </div>
          </div>
        </div>
      </li>
    </ol>
