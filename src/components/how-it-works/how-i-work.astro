---
const PROCESS_STEPS = [
  {
    num: "1",
    title: "1. Understand",
    cmd: "$ runbook understand --incident",
    desc: "Map failure domains, SLO targets, and real developer bottlenecks before touching YAML.",
    res: "failure domains mapped · 3 bottlenecks identified",
  },
  {
    num: "2",
    title: "2. Plan",
    cmd: "$ plan review --blast-radius",
    desc: "Draft small, reversible architecture plans with explicit blast-radius and rollback bounds.",
    res: "architecture approved · rollback verified",
  },
  {
    num: "3",
    title: "3. Delegate / Build",
    cmd: "$ scaffold golden-path --module=core",
    desc: "Codify golden paths, reusable Terraform modules, and automated CI/CD workflows.",
    res: "3 modules codified · pipeline green",
  },
  {
    num: "4",
    title: "4. Review",
    cmd: "$ chaos test --dry-run --policy=strict",
    desc: "Enforce policy-as-code checks, dry-run diffs, and failure-injection drills in staging.",
    res: "policy checks passed · 0 violations",
  },
  {
    num: "5",
    title: "5. Measure",
    cmd: "$ slo verify --p99 --window=30d",
    desc: "Verify deploy lead time, error-budget burn, and p99 latency against production SLOs.",
    res: "p99 < 85ms · 99.95% SLO held",
  },
] as const;

const [step1, step2, step3, step4, step5] = PROCESS_STEPS;
---

<div class="site-container py-28 text-[var(--text)]">
  <p>
    <a
      href="#process"
      data-section-eyebrow="process"
      class="section-eyebrow font-mono text-xs uppercase tracking-[0.25em]"
      aria-label="05 Process section: Execution model"
    >
      05 / Process / Execution model
    </a>
  </p>
  <h2 class="mt-4 max-w-3xl text-[clamp(26px,3vw,40px)] font-bold leading-[1.1] tracking-tight">
    How I <span class="text-signal">work</span> from incident to system.
  </h2>

  {/* CSS Grid 3 columns x 2 content rows (snake pattern) with explicit connector columns/rows */}
  <div data-flow-stage class="flow-stage relative mt-16 w-full lg:mt-20">
    <ol
      class="flow-grid flex flex-col gap-6 min-[860px]:grid min-[860px]:grid-cols-[1fr_34px_1fr_34px_1fr] min-[860px]:grid-rows-[auto_34px_auto] min-[860px]:gap-0 min-[860px]:items-center w-full"
    >
      {/* 1. Step 1: Understand (Row 1, Col 1) */}
      <li
        data-flow-card
        data-step-index={0}
        data-step-cmd={step1.cmd}
        class="flow-card relative z-10 w-full overflow-hidden rounded-2xl border border-[var(--terminal-border)] bg-[var(--terminal-bg)] text-[var(--terminal-fg)] shadow-[var(--terminal-shadow)] transition-all duration-300 ease-out min-[860px]:[grid-column:1] min-[860px]:[grid-row:1]"
      >
        <div class="flex items-center border-b border-[var(--terminal-header-border)] bg-[var(--terminal-header-bg)] px-4 py-2.5">
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="h-2 w-2 rounded-full bg-[#FF5F56]/85" />
            <span class="h-2 w-2 rounded-full bg-[#FFBD2E]/85" />
            <span class="h-2 w-2 rounded-full bg-[#27C93F]/85" />
          </div>
        </div>
        <div class="p-4 sm:p-5">
          <div class="font-mono text-xs font-semibold text-[#E8503A] text-signal truncate flex items-center min-h-[1.25rem]"><span data-flow-cmd-text>{step1.cmd}</span><span data-flow-cursor class="ml-0.5 inline-block text-[#E8503A] text-signal font-bold" aria-hidden="true" style="display: none;">▍</span></div>
          <div data-flow-body class="flow-body">
            <h3 class="font-display text-base font-bold tracking-tight text-[var(--terminal-fg)] mt-2.5 sm:text-lg">
              {step1.title}
            </h3>
            <p class="font-mono text-[11px] leading-relaxed text-[var(--terminal-dim)] mt-1.5 sm:text-xs">
              {step1.desc}
            </p>
          </div>
          <div
            data-flow-result
            class="flow-result mt-3.5 flex items-center gap-2 border-t border-[var(--terminal-header-border)] pt-3 font-mono text-[11px] font-medium text-[var(--terminal-success)] sm:text-xs"
          >
            <span class="font-bold">✓</span>
            <span class="truncate">{step1.res}</span>
          </div>
        </div>
      </li>

      {/* Connector 0: Step 1 -> Step 2 (Horizontal Right, Row 1, Col 2) */}
      <li
        data-flow-connector="0"
        aria-hidden="true"
        class="flow-connector hidden min-[860px]:flex h-full w-full items-center justify-center min-[860px]:[grid-column:2] min-[860px]:[grid-row:1]"
      >
        <svg viewBox="0 0 34 24" class="h-6 w-[34px] overflow-visible" aria-hidden="true">
          <path
            data-connector-line
            d="M 0 12 L 24 12"
            stroke="#E8503A"
            stroke-width="2"
            stroke-linecap="round"
            fill="none"
          />
          <polygon data-connector-arrow points="23,7 33,12 23,17" fill="#E8503A" />
        </svg>
      </li>

      {/* 2. Step 2: Plan (Row 1, Col 3) */}
      <li
        data-flow-card
        data-step-index={1}
        data-step-cmd={step2.cmd}
        class="flow-card relative z-10 w-full overflow-hidden rounded-2xl border border-[var(--terminal-border)] bg-[var(--terminal-bg)] text-[var(--terminal-fg)] shadow-[var(--terminal-shadow)] transition-all duration-300 ease-out min-[860px]:[grid-column:3] min-[860px]:[grid-row:1]"
      >
        <div class="flex items-center border-b border-[var(--terminal-header-border)] bg-[var(--terminal-header-bg)] px-4 py-2.5">
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="h-2 w-2 rounded-full bg-[#FF5F56]/85" />
            <span class="h-2 w-2 rounded-full bg-[#FFBD2E]/85" />
            <span class="h-2 w-2 rounded-full bg-[#27C93F]/85" />
          </div>
        </div>
        <div class="p-4 sm:p-5">
          <div class="font-mono text-xs font-semibold text-[#E8503A] text-signal truncate flex items-center min-h-[1.25rem]"><span data-flow-cmd-text>{step2.cmd}</span><span data-flow-cursor class="ml-0.5 inline-block text-[#E8503A] text-signal font-bold" aria-hidden="true" style="display: none;">▍</span></div>
          <div data-flow-body class="flow-body">
            <h3 class="font-display text-base font-bold tracking-tight text-[var(--terminal-fg)] mt-2.5 sm:text-lg">
              {step2.title}
            </h3>
            <p class="font-mono text-[11px] leading-relaxed text-[var(--terminal-dim)] mt-1.5 sm:text-xs">
              {step2.desc}
            </p>
          </div>
          <div
            data-flow-result
            class="flow-result mt-3.5 flex items-center gap-2 border-t border-[var(--terminal-header-border)] pt-3 font-mono text-[11px] font-medium text-[var(--terminal-success)] sm:text-xs"
          >
            <span class="font-bold">✓</span>
            <span class="truncate">{step2.res}</span>
          </div>
        </div>
      </li>

      {/* Connector 1: Step 2 -> Step 3 (Horizontal Right, Row 1, Col 4) */}
      <li
        data-flow-connector="1"
        aria-hidden="true"
        class="flow-connector hidden min-[860px]:flex h-full w-full items-center justify-center min-[860px]:[grid-column:4] min-[860px]:[grid-row:1]"
      >
        <svg viewBox="0 0 34 24" class="h-6 w-[34px] overflow-visible" aria-hidden="true">
