---
import Icon from "../shared/icon.astro";
import CardParticleBackground from "../shared/card-particle-background.astro";

export interface CredentialItem {
  id: string;
  title: string;
  rank?: string | null;
  shortDescription: string;
  fullDescription?: string;
  year: string;
  issuer?: string;
  organization?: string;
  images?: string[];
  links?: Array<{ label: string; url: string }>;
}

interface Props {
  item: CredentialItem;
  index?: number;
}

const { item, index = 0 } = Astro.props;
const hasRank = Boolean(item.rank && item.rank.trim().length > 0);
const firstLink = item.links && item.links.length > 0 ? item.links[0] : null;
---

<div data-reveal style={`--reveal-delay: ${(index % 3) * 0.1}s`}>
  <article
    data-credential-card={item.id}
    tabindex="0"
    data-cursor-interactive="true"
    class="work-card section-surface group relative overflow-hidden flex h-full flex-col justify-between rounded-3xl border hairline p-7 sm:p-8 focus-visible:outline-none transition-all duration-200 hover:border-signal/50"
  >
    <CardParticleBackground />
    <div class="relative z-10 flex flex-1 flex-col justify-between">
      <div>
        {/* Title */}
        <h3 class="text-lg sm:text-xl font-bold tracking-tight text-[var(--text)] leading-snug">
          {item.title}
        </h3>

        {/* Rank/achievement badge — ONLY if one exists for that entry */}
        {hasRank && (
          <div class="mt-3">
            <span class="inline-flex items-center rounded-full bg-signal/15 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-signal">
              {item.rank}
            </span>
          </div>
        )}

        {/* Short one-to-two-line description */}
        <p class="mt-3 text-sm sm:text-[15px] leading-relaxed dim line-clamp-2">
          {item.shortDescription}
        </p>
      </div>

      {/* Bottom Row: Year subtly shown + View details button & external link */}
      <div class="mt-6 border-t hairline pt-4 flex items-center justify-between font-mono text-xs">
        <p class="uppercase tracking-widest dim text-[11px]">
          Year · <span class="text-signal font-semibold">{item.year}</span>
        </p>
        <div class="flex items-center gap-3">
          {firstLink && (
            <a
              href={firstLink.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`External link for ${item.title}`}
              class="text-[var(--text)]/60 transition-colors hover:text-signal focus-visible:text-signal focus-visible:outline-none"
              title={firstLink.label}
              onclick="event.stopPropagation()"
            >
              <Icon name="ArrowUpRight" class="h-4 w-4" />
            </a>
          )}
          <button
            type="button"
            data-credential-open={item.id}
            class="credential-open-btn group/btn inline-flex items-center gap-1 font-mono text-xs font-semibold uppercase tracking-wider text-[var(--text)]/70 transition-all duration-200 hover:text-signal focus-visible:text-signal focus-visible:outline-none cursor-pointer"
            aria-haspopup="dialog"
            aria-controls="credential-modal"
            aria-label={`View details for ${item.title}`}
          >
            <span>View details</span>
            <span
              class="inline-block transition-transform duration-200 group-hover/btn:translate-x-1"
              aria-hidden="true"
            >
              →
            </span>
          </button>
        </div>
      </div>
    </div>
  </article>
</div>

