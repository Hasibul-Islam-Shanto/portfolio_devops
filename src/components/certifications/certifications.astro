---
import Icon from "../shared/icon.astro";

const ACHIEVEMENTS = [
  {
    title: "Smart Village Idea Competition",
    year: "2023",
    badge: "1st Runner-Up",
    project: "Ethereum-based Agri-Food Supply Chain",
    image: "/images/idea_competition.webp",
    link: null,
  },
  {
    title: "Bangladesh Blockchain Olympiad",
    year: "2023",
    badge: "Top 10 Finalist",
    project: "Digital Sharecropper (Team Block-bit)",
    image: "/images/blockchain_competition.webp",
    link: null,
  },
  {
    title: "ICCIT IEEE Research Paper",
    year: "2023",
    badge: "Published Author",
    project: "Blockchain-driven Agriculture Transparency",
    image: null,
    link: "https://ieeexplore.ieee.org/abstract/document/10441096",
  },
  {
    title: "B.Sc. in Computer Science & Eng.",
    year: "2024",
    badge: "3.52 CGPA",
    project: "Shahjalal University of Sci. & Tech.",
    image: null,
    link: null,
  },
];
---

<div class="site-container py-28">
  <p>
    <a
      href="#certifications"
      data-section-eyebrow="certifications"
      class="section-eyebrow font-mono text-xs uppercase tracking-[0.25em]"
      aria-label="04 Certifications section: Verified skills & honors"
    >
      04 / Verified skills &amp; honors
    </a>
  </p>
  <h2 class="mt-4 max-w-3xl text-[clamp(26px,3vw,40px)] font-bold leading-[1.1] tracking-tight">
    Recognitions &amp; Credentials
  </h2>
  <div class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      ACHIEVEMENTS.map((item, i) => (
        <div data-reveal style={`--reveal-delay: ${i * 0.1}s`}>
          <article
            tabindex="0"
            data-cursor-interactive="true"
            class="group relative flex h-full flex-col justify-between overflow-hidden rounded-3xl border hairline p-6 transition-all duration-300 hover:border-signal focus-visible:border-signal focus-visible:outline-none"
          >
            {item.image && (
              <div class="mb-4 aspect-[16/10] w-full overflow-hidden rounded-xl border hairline bg-surface/50">
                <img
                  src={item.image}
                  alt={item.title}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
            )}
            <div class="flex-1">
              {!item.image && (
                <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl border hairline bg-surface text-signal transition-colors duration-300 group-hover:border-signal">
                  <Icon name="ShieldCheck" class="h-6 w-6" strokeWidth={1.5} />
                </div>
              )}
              <div class="flex items-center justify-between gap-2">
                <span class="inline-block rounded-full bg-signal/15 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-signal">
                  {item.badge}
                </span>
                {item.link && (
                  <a
                    href={item.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`View external link for ${item.title}`}
                    class="text-[var(--text)]/60 transition-colors hover:text-signal"
                  >
                    <Icon name="ArrowUpRight" class="h-4 w-4" />
                  </a>
                )}
              </div>
              <h3 class="mt-3 text-base font-bold leading-snug tracking-tight sm:text-lg">
                {item.title}
              </h3>
              <p class="mt-1 font-mono text-xs text-[var(--text)]/70">
                {item.project}
              </p>
            </div>
            <p class="mt-6 border-t hairline pt-4 font-mono text-xs uppercase tracking-widest dim">
              Year · <span class="text-signal">{item.year}</span>
            </p>
          </article>
        </div>
      ))
    }
  </div>
</div>

