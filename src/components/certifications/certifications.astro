---
import CredentialCard from "./credential-card.astro";
import CredentialModal from "./credential-modal.astro";
import achievementsData from "../../data/achievements.json";
import type { CredentialItem } from "./credential-types";

const ACHIEVEMENTS: CredentialItem[] = achievementsData;
const HOMEPAGE_FEATURED_IDS = [
  "bangladesh-blockchain-olympiad",
  "docker-escbash-labs",
  "github-actions-escbash",
];
const displayedItems: CredentialItem[] = HOMEPAGE_FEATURED_IDS.map((id) =>
  ACHIEVEMENTS.find((item) => item.id === id),
).filter((item): item is CredentialItem => item !== undefined);
---

<div class="site-container py-28">
  <p>
    <a
      href="#certifications"
      data-section-eyebrow="certifications"
      class="section-eyebrow font-mono text-xs uppercase tracking-[0.25em]"
      aria-label="04 Certifications section: Verified skills & honors"
    >
      04 / Verified skills &amp; honors
    </a>
  </p>
  <h2 class="mt-4 max-w-3xl text-[clamp(26px,3vw,40px)] font-bold leading-[1.1] tracking-tight">
    Recognitions &amp; Credentials
  </h2>

  <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
    {displayedItems.map((item, i) => (
      <CredentialCard item={item} index={i} />
    ))}
  </div>

  <div class="mt-12 flex justify-center">
    <a
      href="/achievements"
      class="group inline-flex items-center gap-2 rounded-full border hairline bg-surface/40 px-6 py-3 font-mono text-xs font-semibold uppercase tracking-wider text-[var(--text)] transition-all duration-200 hover:border-signal hover:text-signal hover:-translate-y-0.5 focus-visible:border-signal focus-visible:outline-none"
    >
      <span>View all recognitions &amp; credentials</span>
      <span
        aria-hidden="true"
        class="inline-block transition-transform duration-200 group-hover:translate-x-1"
      >
        →
      </span>
    </a>
  </div>

  <CredentialModal items={ACHIEVEMENTS} />
</div>

<script>
  import { initCredentialModal } from "./credential-modal";
  initCredentialModal();
</script>
