---
import type { CredentialItem } from "./credential-types";

interface Props {
  items: CredentialItem[];
}

const { items } = Astro.props;
---

<div
  id="credential-modal"
  class="credential-modal fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 lg:p-8"
  role="dialog"
  aria-modal="true"
  aria-labelledby="credential-modal-title"
  aria-hidden="true"
  hidden
>
  <div
    class="credential-modal-backdrop fixed inset-0 bg-black/80 backdrop-blur-sm cursor-pointer"
    data-credential-close
    aria-hidden="true"
  ></div>

  <div
    class="credential-modal-dialog relative z-10 w-full max-w-2xl max-h-[90vh] overflow-y-auto rounded-3xl border hairline bg-[var(--card-bg)] text-[var(--card-fg)] p-6 sm:p-8 shadow-2xl focus:outline-none"
    tabindex="-1"
  >
    <button
      type="button"
      data-credential-close
      class="credential-modal-close absolute top-5 right-5 sm:top-6 sm:right-6 inline-flex h-9 w-9 items-center justify-center rounded-full border hairline bg-surface/60 text-[var(--text)]/70 transition-colors hover:border-signal hover:text-signal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-signal cursor-pointer"
      aria-label="Close details modal"
    >
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>

    <div class="pr-6 sm:pr-8">
      <h3
        id="credential-modal-title"
        class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text)] leading-snug"
      ></h3>

      <div id="credential-modal-rank-wrapper" class="mt-3">
        <span
          id="credential-modal-rank"
          class="inline-flex items-center rounded-full bg-signal/15 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-signal"
        ></span>
      </div>

      <p
        id="credential-modal-desc"
        class="mt-4 text-sm sm:text-base leading-relaxed dim whitespace-pre-line"
      ></p>

      <div id="credential-modal-images-wrapper" class="mt-6 space-y-4"></div>

      <div id="credential-modal-links-wrapper" class="mt-6 flex flex-wrap gap-3"></div>

      <div class="mt-8 border-t hairline pt-4 flex flex-wrap items-center justify-between gap-3 font-mono text-xs">
        <div class="dim">
          <span class="uppercase tracking-wider">Issuer · </span>
          <span id="credential-modal-issuer" class="text-[var(--text)] font-semibold"></span>
        </div>
        <div class="dim uppercase tracking-widest">
          Year · <span id="credential-modal-year" class="text-signal font-semibold"></span>
        </div>
      </div>
    </div>
  </div>
</div>

<script id="credentials-data" type="application/json" set:html={JSON.stringify(items)}></script>
