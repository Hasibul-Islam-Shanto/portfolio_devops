---
import { TECH_LOGOS } from "./tech-marquee-data";
---

<div
  role="region"
  aria-label="Technologies I work with"
  class="tech-marquee-section relative w-full bg-[var(--marquee-bg)] py-7 sm:py-8 overflow-hidden select-none"
>
  <div class="tech-marquee-wrapper relative w-full overflow-hidden">
    <div class="tech-marquee-track flex w-max">
      <div class="tech-marquee-group flex shrink-0 items-center gap-4 sm:gap-5 pr-4 sm:pr-5">
        {TECH_LOGOS.map((tech) => (
          <div class="tech-pill inline-flex items-center rounded-full bg-[var(--marquee-pill-bg)] border border-[var(--marquee-pill-border)] py-2 px-3.5 sm:py-2.5 sm:px-5 gap-2.5 sm:gap-3 shrink-0 shadow-xs transition-colors duration-200 hover:border-[var(--marquee-pill-hover)]">
            <div class="flex h-8 w-8 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-full bg-white shadow-xs p-1 sm:p-1.5">
              <Fragment set:html={tech.svg} />
            </div>
            <span class="font-sans text-[14px] sm:text-[16px] font-medium tracking-tight text-[var(--marquee-text)] whitespace-nowrap">
              {tech.name}
            </span>
          </div>
        ))}
      </div>

      <div
        class="tech-marquee-group flex shrink-0 items-center gap-4 sm:gap-5 pr-4 sm:pr-5"
        aria-hidden="true"
      >
        {TECH_LOGOS.map((tech) => (
          <div
            tabindex="-1"
            class="tech-pill inline-flex items-center rounded-full bg-[var(--marquee-pill-bg)] border border-[var(--marquee-pill-border)] py-2 px-3.5 sm:py-2.5 sm:px-5 gap-2.5 sm:gap-3 shrink-0 shadow-xs transition-colors duration-200 hover:border-[var(--marquee-pill-hover)]"
          >
            <div class="flex h-8 w-8 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-full bg-white shadow-xs p-1 sm:p-1.5">
              <Fragment set:html={tech.svg} />
            </div>
            <span class="font-sans text-[14px] sm:text-[16px] font-medium tracking-tight text-[var(--marquee-text)] whitespace-nowrap">
              {tech.name}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .tech-marquee-section {
    background-color: var(--marquee-bg);
  }

  .tech-marquee-wrapper {
    mask-image: linear-gradient(to right, transparent 0%, black 5vw, black 95vw, transparent 100%);
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 5vw,
      black 95vw,
      transparent 100%
    );
  }

  .tech-marquee-track {
    display: flex;
    width: max-content;
    user-select: none;
  }

  .tech-marquee-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    will-change: transform;
    animation: tech-marquee-scroll 30s linear infinite;
  }

  @keyframes tech-marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  .tech-marquee-wrapper:hover .tech-marquee-group,
  .tech-marquee-wrapper:focus-within .tech-marquee-group {
    animation-play-state: paused;
  }

  @media (max-width: 640px) {
    .tech-marquee-group {
      animation-duration: 28s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-marquee-wrapper {
      mask-image: none !important;
      -webkit-mask-image: none !important;
      overflow-x: auto;
    }
    .tech-marquee-track {
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      padding: 0 1rem;
    }
    .tech-marquee-group {
      animation: none !important;
      flex-wrap: wrap;
      justify-content: center;
      padding-right: 0 !important;
    }
    .tech-marquee-group[aria-hidden="true"] {
      display: none !important;
    }
  }
</style>
