---
import "../styles/global.css";
import CustomCursor from "../components/shared/custom-cursor.astro";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  twitterCard?: "summary" | "summary_large_image";
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogType = "website",
  twitterCard = "summary",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content={twitterCard} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Space+Grotesk:wght@400;500;700&display=swap"
    />
    <script is:inline>
      // Marks that JS is running so reveal animations only hide content when they can also show it.
      document.documentElement.classList.add("js");

      // Synchronous theme initialization to prevent flash of unstyled theme (FOUT)
      try {
        const stored = localStorage.getItem("theme");
        const prefersDark =
          window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme =
          stored === "light" || stored === "dark" ? stored : prefersDark ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", theme);
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      } catch {
        document.documentElement.setAttribute("data-theme", "dark");
        document.documentElement.classList.add("dark");
      }

      // Early click listener so theme toggling responds instantly even before JS modules hydrate
      document.addEventListener("click", function (e) {
        if (e.defaultPrevented) return;
        var btn = e.target && e.target.closest ? e.target.closest("[data-theme-toggle]") : null;
        if (!btn) return;
        e.preventDefault();
        var current =
          document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
        var next = current === "light" ? "dark" : "light";
        var reduced =
          window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!reduced) {
          document.documentElement.classList.add("theme-transitioning");
          setTimeout(function () {
            document.documentElement.classList.remove("theme-transitioning");
          }, 400);
        }
        document.documentElement.setAttribute("data-theme", next);
        document.documentElement.classList.toggle("dark", next === "dark");
        try {
          localStorage.setItem("theme", next);
        } catch (err) {}
        var toggles = document.querySelectorAll("[data-theme-toggle]");
        for (var i = 0; i < toggles.length; i++) {
          toggles[i].setAttribute(
            "aria-label",
            "Switch to " + (next === "dark" ? "light" : "dark") + " theme"
          );
          toggles[i].setAttribute(
            "title",
            "Switch to " + (next === "dark" ? "light" : "dark") + " theme"
          );
        }
      });
    </script>
  </head>
  <body>
    <CustomCursor />
    <slot />
    <script>
      import { initReveal } from "../scripts/reveal";
      import { initTheme } from "../scripts/theme";
      initTheme();
      initReveal();
    </script>
  </body>
</html>
