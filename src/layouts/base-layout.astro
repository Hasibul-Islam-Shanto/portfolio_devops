---
import "../styles/global.css";
import CustomCursor from "../components/shared/custom-cursor.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  robots?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogUrl?: string;
  ogImage?: string;
  siteName?: string;
  twitterCard?: "summary" | "summary_large_image";
}

const {
  title,
  description,
  canonical = "https://shanto-devops.vercel.app/",
  robots = "index, follow",
  ogTitle = title,
  ogDescription = description,
  ogType = "website",
  ogUrl = canonical,
  ogImage = "https://shanto-devops.vercel.app/og-image.png",
  siteName = "Shanto.devOps",
  twitterCard = "summary_large_image",
} = Astro.props;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Hasibul Islam Shanto",
  alternateName: "Shanto",
  url: "https://shanto-devops.vercel.app/",
  email: "mailto:mdhasibulislamshanto007@gmail.com",
  jobTitle: "DevOps Engineer",
  description:
    "DevOps Engineer and Software Engineer specializing in CI/CD, Kubernetes, and cloud infrastructure, with a background in front-end engineering.",
  sameAs: [
    "https://github.com/Hasibul-Islam-Shanto",
    "https://www.linkedin.com/in/hasibul-islam-shanto-80487a217/",
  ],
  knowsAbout: [
    "DevOps",
    "Software Engineering",
    "Kubernetes",
    "CI/CD",
    "Docker",
    "Terraform",
    "AWS",
    "Frontend Engineering",
  ],
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Shanto.devOps — Portfolio",
  url: "https://shanto-devops.vercel.app/",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Space+Grotesk:wght@400;500;700&display=swap"
    />
    <script is:inline>
      document.documentElement.classList.add("js");

      try {
        const stored = localStorage.getItem("theme");
        const prefersDark =
          window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme =
          stored === "light" || stored === "dark" ? stored : prefersDark ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", theme);
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      } catch {
        document.documentElement.setAttribute("data-theme", "dark");
        document.documentElement.classList.add("dark");
      }

      document.addEventListener("click", function (e) {
        if (e.defaultPrevented) return;
        const target = e.target;
        const btn = target && target.closest ? target.closest("[data-theme-toggle]") : null;
        if (!btn) return;
        e.preventDefault();
        const current =
          document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
        const next = current === "light" ? "dark" : "light";
        const reduced =
          window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!reduced) {
          document.documentElement.classList.add("theme-transitioning");
          setTimeout(function () {
            document.documentElement.classList.remove("theme-transitioning");
          }, 400);
        }
        document.documentElement.setAttribute("data-theme", next);
        document.documentElement.classList.toggle("dark", next === "dark");
        try {
          localStorage.setItem("theme", next);
        } catch (_err) {}
        const toggles = document.querySelectorAll("[data-theme-toggle]");
        for (let i = 0; i < toggles.length; i++) {
          toggles[i]?.setAttribute(
            "aria-label",
            "Switch to " + (next === "dark" ? "light" : "dark") + " mode",
          );
          toggles[i]?.setAttribute(
            "title",
            "Switch to " + (next === "dark" ? "light" : "dark") + " mode",
          );
        }
      });
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-full focus:bg-signal focus:px-5 focus:py-2.5 focus:font-mono focus:text-xs focus:font-bold focus:uppercase focus:text-signal-foreground focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-[var(--bg)]"
    >
      Skip to main content
    </a>
    <CustomCursor />
    <slot />
    <script>
      import { initReveal } from "../scripts/reveal";
      import { initTheme } from "../scripts/theme";
      initTheme();
      initReveal();
    </script>
  </body>
</html>
