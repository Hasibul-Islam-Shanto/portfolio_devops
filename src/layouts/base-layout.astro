---
import "../styles/global.css";
import CustomCursor from "../components/shared/custom-cursor.astro";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogImage?: string;
  twitterCard?: "summary" | "summary_large_image";
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogType = "website",
  ogImage = "/images/shanto_dp.webp",
  twitterCard = "summary_large_image",
} = Astro.props;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.hi-shanto.me/#person",
  name: "Hasibul Islam Shanto",
  givenName: "Hasibul",
  familyName: "Shanto",
  jobTitle: "DevOps Engineer",
  description:
    "I started in product UI, then followed the work into APIs, databases, and the pipelines that keep them shipping. Today I build CI/CD, containers, and cloud infrastructure so production stays boring.",
  url: "https://www.hi-shanto.me",
  image: "https://www.hi-shanto.me/images/shanto_dp.webp",
  email: "mailto:mdhasibulislamshanto007@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Dhaka",
    addressCountry: "BD",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Shahjalal University of Science and Technology",
  },
  sameAs: [
    "https://github.com/Hasibul-Islam-Shanto",
    "https://www.linkedin.com/in/hasibul-islam-shanto-80487a217/",
    "https://x.com/hi_shanto078",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Space+Grotesk:wght@400;500;700&display=swap"
    />
    <script is:inline>
      document.documentElement.classList.add("js");

      try {
        const stored = localStorage.getItem("theme");
        const prefersDark =
          window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme =
          stored === "light" || stored === "dark" ? stored : prefersDark ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", theme);
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      } catch {
        document.documentElement.setAttribute("data-theme", "dark");
        document.documentElement.classList.add("dark");
      }

      document.addEventListener("click", function (e) {
        if (e.defaultPrevented) return;
        const target = e.target;
        const btn = target && target.closest ? target.closest("[data-theme-toggle]") : null;
        if (!btn) return;
        e.preventDefault();
        const current =
          document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
        const next = current === "light" ? "dark" : "light";
        const reduced =
          window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!reduced) {
          document.documentElement.classList.add("theme-transitioning");
          setTimeout(function () {
            document.documentElement.classList.remove("theme-transitioning");
          }, 400);
        }
        document.documentElement.setAttribute("data-theme", next);
        document.documentElement.classList.toggle("dark", next === "dark");
        try {
          localStorage.setItem("theme", next);
        } catch (_err) {}
        const toggles = document.querySelectorAll("[data-theme-toggle]");
        for (let i = 0; i < toggles.length; i++) {
          toggles[i]?.setAttribute(
            "aria-label",
            "Switch to " + (next === "dark" ? "light" : "dark") + " theme",
          );
          toggles[i]?.setAttribute(
            "title",
            "Switch to " + (next === "dark" ? "light" : "dark") + " theme",
          );
        }
      });
    </script>
  </head>
  <body>
    <CustomCursor />
    <slot />
    <script>
      import { initReveal } from "../scripts/reveal";
      import { initTheme } from "../scripts/theme";
      initTheme();
      initReveal();
    </script>
  </body>
</html>
