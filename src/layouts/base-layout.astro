---
import "../styles/global.css";
import CustomCursor from "../components/portfolio/custom-cursor.astro";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  twitterCard?: "summary" | "summary_large_image";
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogType = "website",
  twitterCard = "summary",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content={twitterCard} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Space+Grotesk:wght@400;500;700&display=swap"
    />
    <script is:inline>
      // Marks that JS is running so reveal animations only hide content when they can also show it.
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <CustomCursor />
    <slot />
    <script>
      import { initReveal } from "../scripts/reveal";
      initReveal();
    </script>
  </body>
</html>
